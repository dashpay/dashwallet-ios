			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%2$d nod</string>
			<key>few</key>
			<string>%2$d noduri</string>
			<key>other</key>
			<string>%2$d de noduri</string>
		</dict>
