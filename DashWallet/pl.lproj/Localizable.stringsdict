			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%1$d ATM in %2$@</string>
			<key>other</key>
			<string>%1$d ATMs in %2$@</string>
			<key>few</key>
			<string>%1$d ATMs in %2$@</string>
			<key>many</key>
			<string>%1$d ATMs in %2$@</string>
		</dict>
	</dict>
