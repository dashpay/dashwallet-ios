<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%ld used</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@used@</string>
		<key>used</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld використано</string>
			<key>few</key>
			<string>%ld використано</string>
			<key>many</key>
			<string>%ld використано</string>
			<key>other</key>
			<string>%ld використано</string>
		</dict>
	</dict>
	<key>%d ATM(s) in %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@atms@</string>
		<key>atms</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%1$d ATM in %2$@</string>
			<key>other</key>
			<string>%1$d ATMs in %2$@</string>
			<key>few</key>
			<string>%1$d ATMs in %2$@</string>
			<key>many</key>
			<string>%1$d ATMs in %2$@</string>
		</dict>
	</dict>
	<key>%d merchant(s) in %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@merchants@</string>
		<key>merchants</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d продавець у %@</string>
			<key>few</key>
			<string>%d продавців у %@</string>
			<key>many</key>
			<string>%d продавців у %@</string>
			<key>other</key>
			<string>%d продавців у %@</string>
		</dict>
	</dict>
	<key>%d merchant(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@merchants@</string>
		<key>merchants</key>
