    "Payments with each contact are grouped in one place, with names and profiles instead of raw transactions." : {
      "comment" : "DashPay intro: feature body",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُجمَّع المدفوعات مع كل جهة اتصال في مكان واحد، بالأسماء والملفات الشخصية بدلاً من المعاملات الخام."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плащанията с всеки контакт са събрани на едно място, с имена и профили вместо сурови транзакции."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els pagaments amb cada contacte s'agrupen en un sol lloc, amb noms i perfils en comptes de transaccions en cru."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platby s každým kontaktem jsou seskupeny na jednom místě, se jmény a profily místo surových transakcí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betalingerne med hver kontakt samles ét sted, med navne og profiler i stedet for rå transaktioner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahlungen mit jedem Kontakt sind an einem Ort gebündelt, mit Namen und Profilen statt roher Transaktionen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι πληρωμές με κάθε επαφή ομαδοποιούνται σε ένα σημείο, με ονόματα και προφίλ αντί για ακατέργαστες συναλλαγές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payments with each contact are grouped in one place, with names and profiles instead of raw transactions."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pagoj kun ĉiu kontakto grupiĝas en unu loko, kun nomoj kaj profiloj anstataŭ krudaj transakcioj."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pagos con cada contacto se agrupan en un solo lugar, con nombres y perfiles en vez de transacciones sin procesar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iga kontaktiga tehtud maksed on koondatud ühte kohta, nimede ja profiilidega toortehingute asemel."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پرداخت‌ها با هر مخاطب در یک جا گرد می‌آیند، با نام و نمایه به‌جای تراکنش‌های خام."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunkin yhteystiedon kanssa tehdyt maksut on koottu yhteen paikkaan, nimineen ja profiileineen raakatapahtumien sijaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakagrupo sa isang lugar ang mga bayad sa bawat kontak, may pangalan at profile sa halip na raw na transaksyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paiements avec chaque contact sont regroupés au même endroit, avec des noms et des profils au lieu de transactions brutes."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plaćanja sa svakim kontaktom grupirana su na jednom mjestu, s imenima i profilima umjesto sirovih transakcija."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az egyes névjegyekkel folytatott fizetések egy helyen csoportosulnak, nyers tranzakciók helyett nevekkel és profilokkal."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembayaran dengan setiap kontak dikelompokkan di satu tempat, dengan nama dan profil alih-alih transaksi mentah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pagamenti con ogni contatto sono raggruppati in un unico posto, con nomi e profili al posto di transazioni grezze."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各連絡先との支払いが 1 か所にまとまり、生の取引ではなく名前とプロフィールで表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연락처별 결제가 한곳에 묶여, 원시 거래 대신 이름과 프로필로 표시됩니다."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плаќањата со секој контакт се групирани на едно место, со имиња и профили наместо сурови трансакции."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembayaran dengan setiap kenalan dikumpulkan di satu tempat, dengan nama dan profil, bukan transaksi mentah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betalingene med hver kontakt er samlet på ett sted, med navn og profiler i stedet for rå transaksjoner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betalingen met elk contact staan op één plek bij elkaar, met namen en profielen in plaats van ruwe transacties."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Płatności z każdym kontaktem są zebrane w jednym miejscu, z nazwami i profilami zamiast surowych transakcji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
