    "You can withdraw up to %@ DASH — the rest stays to cover the Platform fee. Tap Max to use it." : {
      "comment" : "Evonode withdrawal",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك سحب ما يصل إلى %@ DASH — ويبقى الباقي لتغطية رسوم Platform. اضغط «الحد الأقصى» لاستخدامه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можете да изтеглите до %@ DASH — останалото остава за покриване на таксата на Platform. Докоснете „Макс.“, за да го използвате."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pots retirar fins a %@ DASH — la resta es queda per cobrir la comissió de Platform. Toca «Màx.» per fer-la servir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Můžete vybrat až %@ DASH — zbytek zůstává na pokrytí poplatku Platform. Klepnutím na „Max“ jej použijete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan hæve op til %@ DASH — resten bliver tilbage for at dække Platform-gebyret. Tryk på “Maks” for at bruge det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst bis zu %@ DASH auszahlen — der Rest bleibt zur Deckung der Platform-Gebühr. Tippe auf „Max“, um ihn zu verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορείτε να αποσύρετε έως %@ DASH — τα υπόλοιπα μένουν για να καλύψουν το τέλος του Platform. Πατήστε «Μέγ.» για να τα χρησιμοποιήσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can withdraw up to %@ DASH — the rest stays to cover the Platform fee. Tap Max to use it."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi povas elpreni ĝis %@ DASH — la cetero restas por kovri la Platform-kotizon. Frapetu „Maks“ por uzi ĝin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes retirar hasta %@ DASH — el resto se queda para cubrir la comisión de Platform. Toca «Máx.» para usarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saad välja võtta kuni %@ DASH — ülejäänu jääb Platformi tasu katteks. Selle kasutamiseks puuduta „Maks“."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "می‌توانید تا %@ DASH برداشت کنید — باقیمانده برای پوشش کارمزد Platform می‌ماند. برای استفاده از آن روی «حداکثر» ضربه بزنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit nostaa enintään %@ DASH — loput jäävät kattamaan Platform-maksun. Käytä se napauttamalla ”Maks.”."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puwede kang mag-withdraw ng hanggang %@ DASH — ang natitira ay nakalaan para sa Platform fee. I-tap ang “Max” para gamitin ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez retirer jusqu'à %@ DASH — le reste sert à couvrir les frais Platform. Touchez « Max » pour l'utiliser."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Možete povući do %@ DASH — ostatak ostaje za pokrivanje Platform naknade. Dodirnite „Maks“ da ga iskoristite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legfeljebb %@ DASH-t vehetsz ki — a többi a Platform díjának fedezésére marad. Koppints a „Max” gombra a használatához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda dapat menarik hingga %@ DASH — sisanya disimpan untuk menutup biaya Platform. Ketuk “Maks” untuk memakainya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi prelevare fino a %@ DASH — il resto rimane per coprire la commissione di Platform. Tocca «Max» per usarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大 %@ DASH まで出金できます — 残りは Platform 手数料に充てられます。「最大」をタップすると使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최대 %@ DASH까지 출금할 수 있습니다 — 나머지는 Platform 수수료로 남습니다. ‘최대’를 탭하면 사용할 수 있습니다."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можете да повлечете до %@ DASH — остатокот останува за да ја покрие таксата на Platform. Допрете „Макс.“ за да го искористите."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda boleh mengeluarkan sehingga %@ DASH — bakinya kekal untuk menampung yuran Platform. Ketik “Maks” untuk menggunakannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ta ut inntil %@ DASH — resten blir igjen for å dekke Platform-gebyret. Trykk på «Maks» for å bruke det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt tot %@ DASH opnemen — de rest blijft staan om de Platform-kosten te dekken. Tik op ‘Max’ om dat te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz wypłacić do %@ DASH — reszta zostaje na pokrycie opłaty Platform. Dotknij „Maks.”, aby jej użyć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode sacar até %@ DASH — o restante fica para cobrir a taxa da Platform. Toque em “Máx.” para usá-lo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poți retrage până la %@ DASH — restul rămâne pentru acoperirea taxei Platform. Atinge „Max” pentru a-l folosi."
          }
        },
        "ru" : {
