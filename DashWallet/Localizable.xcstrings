    "Screenshots are visible to other apps and devices. Generate a new recovery phrase and keep it secret." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تكون لقطات الشاشة مرئية للتطبيقات والأجهزة الأخرى. إنشاء كلمة الإستراد جديدة والحفاظ على سريتها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снимките на екрана са видими от други приложения и устройства. Генерирайте нова фраза за възстановяване и го запазете в тайна."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshots are visible to other apps and devices. Generate a new recovery phrase and keep it secret."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snímky obrazovky jsou dostupné pro ostatní aplikace a zařízení. Vygenerujte novou frázi pro obnovení a udržujte ji v tajnosti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skærmbilleder er synlige for andre apps og enheder. Lav en ny gendannelsessætning og hold den hemmelig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshots sind sichtbar für andere Apps und Geräte. Generieren Sie eine neue Wiederherstellungs-Wortfolge und halten Sie diese geheim."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι λήψεις οθόνης είναι ορατές σε άλλες εφαρμογές και συσκευές. Δημιουργήστε μια νέα φράση ανάκτησης και κρατήστε την μυστική. "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshots are visible to other apps and devices. Generate a new recovery phrase and keep it secret."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshots are visible to other apps and devices. Generate a new recovery phrase and keep it secret."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las capturas de pantalla son visibles para otras aplicaciones y dispositivos. Genere una nueva frase de recuperación y téngala en secreto."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshots are visible to other apps and devices. Generate a new recovery phrase and keep it secret."
          }
        },
        "fa" : {
          "stringUnit" : {
