    "The network voted to lock this name, so nobody can register it. Choose a different name." : {
      "comment" : "Username marketplace: contested label locked by a past vote",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صوّتت الشبكة على قفل هذا الاسم، فلا يمكن لأحد تسجيله. اختر اسمًا آخر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мрежата гласува това име да бъде заключено, така че никой не може да го регистрира. Изберете друго име."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La xarxa ha votat bloquejar aquest nom, així que ningú no el pot registrar. Tria un altre nom."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Síť odhlasovala uzamčení tohoto jména, takže je nikdo nemůže zaregistrovat. Zvolte jiné jméno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Netværket stemte for at låse dette navn, så ingen kan registrere det. Vælg et andet navn."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Netzwerk hat dafür gestimmt, diesen Namen zu sperren, sodass ihn niemand registrieren kann. Wähle einen anderen Namen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το δίκτυο ψήφισε να κλειδώσει αυτό το όνομα, επομένως κανείς δεν μπορεί να το καταχωρήσει. Επιλέξτε άλλο όνομα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The network voted to lock this name, so nobody can register it. Choose a different name."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reto voĉdonis ŝlosi ĉi tiun nomon, do neniu povas registri ĝin. Elektu alian nomon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La red votó bloquear este nombre, así que nadie puede registrarlo. Elige otro nombre."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Võrk hääletas selle nime lukustamise poolt, seega ei saa keegi seda registreerida. Vali teine nimi."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شبکه به قفل‌کردن این نام رأی داد، بنابراین هیچ‌کس نمی‌تواند آن را ثبت کند. نام دیگری انتخاب کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkko äänesti tämän nimen lukitsemisen puolesta, joten kukaan ei voi rekisteröidä sitä. Valitse toinen nimi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bumoto ang network na i-lock ang pangalang ito, kaya walang makakapagrehistro nito. Pumili ng ibang pangalan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le réseau a voté le verrouillage de ce nom : personne ne peut l'enregistrer. Choisissez un autre nom."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mreža je glasala da se ovo ime zaključa, pa ga nitko ne može registrirati. Odaberite drugo ime."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hálózat a név zárolására szavazott, így senki sem regisztrálhatja. Válassz másik nevet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaringan memilih untuk mengunci nama ini, jadi tidak ada yang bisa mendaftarkannya. Pilih nama lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La rete ha votato per bloccare questo nome, quindi nessuno può registrarlo. Scegli un nome diverso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワークはこの名前をロックすることを決議したため、誰も登録できません。別の名前を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네트워크가 이 이름을 잠그기로 투표했으므로 아무도 등록할 수 없습니다. 다른 이름을 선택하세요."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мрежата гласаше ова име да се заклучи, па никој не може да го регистрира. Изберете друго име."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rangkaian mengundi untuk mengunci nama ini, jadi tiada sesiapa boleh mendaftarkannya. Pilih nama lain."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nettverket stemte for å låse dette navnet, så ingen kan registrere det. Velg et annet navn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het netwerk heeft gestemd om deze naam te vergrendelen, dus niemand kan hem registreren. Kies een andere naam."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieć zagłosowała za zablokowaniem tej nazwy, więc nikt nie może jej zarejestrować. Wybierz inną nazwę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rede votou por bloquear este nome, então ninguém pode registrá-lo. Escolha outro nome."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rețeaua a votat blocarea acestui nume, deci nimeni nu îl poate înregistra. Alege alt nume."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеть проголосовала за блокировку этого имени, поэтому никто не может его зарегистрировать. Выберите другое имя."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieť odhlasovala uzamknutie tohto mena, takže ho nikto nemôže zaregistrovať. Zvoľte iné meno."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omrežje je glasovalo, da se to ime zaklene, zato ga nihče ne more registrirati. Izberite drugo ime."
          }
        },
        "sl_SI" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omrežje je glasovalo, da se to ime zaklene, zato ga nihče ne more registrirati. Izberite drugo ime."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rrjeti votoi ta kyçë këtë emër, prandaj askush nuk mund ta regjistrojë. Zgjidh një emër tjetër."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mreža je glasala da se ovo ime zaključa, pa niko ne može da ga registruje. Izaberite drugo ime."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nätverket röstade för att låsa det här namnet, så ingen kan registrera det. Välj ett annat namn."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เครือข่ายโหวตให้ล็อกชื่อนี้ จึงไม่มีใครลงทะเบียนได้ เลือกชื่ออื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağ bu adı kilitlemek için oy verdi, bu nedenle kimse kaydedemez. Farklı bir ad seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мережа проголосувала за блокування цього імені, тож ніхто не може його зареєструвати. Оберіть інше ім'я."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mạng đã bỏ phiếu khoá tên này nên không ai đăng ký được. Hãy chọn tên khác."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网络已投票锁定该名称，因此任何人都无法注册。请另选一个名称。"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "網絡已投票鎖定該名稱，因此任何人都無法註冊。請另選一個名稱。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网络已投票锁定该名称，因此任何人都无法注册。请另选一个名称。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "網絡已投票鎖定該名稱，因此任何人都無法註冊。請另選一個名稱。"
          }
        }
      }
    },
    "The node's own report, unverified — what it says about itself, not what the network has agreed on." : {
      "comment" : "Evonode status",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقرير العقدة عن نفسها، غير مُتحقَّق منه — ما تقوله عن نفسها، لا ما اتفقت عليه الشبكة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Собственият непроверен доклад на възела — това, което той казва за себе си, а не онова, за което мрежата се е съгласила."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'informe del node mateix, no verificat — el que diu de si mateix, no allò que la xarxa ha acordat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlastní neověřené hlášení uzlu — to, co říká sám o sobě, ne to, na čem se shodla síť."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nodens egen, ubekræftede rapport — hvad den siger om sig selv, ikke hvad netværket er blevet enige om."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der eigene, ungeprüfte Bericht der Node — was sie über sich selbst sagt, nicht das, worauf sich das Netzwerk geeinigt hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η δική του, μη επαληθευμένη αναφορά του κόμβου — τι λέει για τον εαυτό του, όχι τι έχει συμφωνήσει το δίκτυο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The node's own report, unverified — what it says about itself, not what the network has agreed on."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La propra, nekontrolita raporto de la nodo — kion ĝi diras pri si mem, ne tion, pri kio la reto interkonsentis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El informe propio del nodo, sin verificar — lo que dice de sí mismo, no lo que la red ha acordado."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sõlme enda kontrollimata aruanne — see, mida ta enda kohta ütleb, mitte see, milles võrk on kokku leppinud."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گزارش خودِ گره، تأییدنشده — آنچه درباره خود می‌گوید، نه آنچه شبکه بر آن توافق کرده است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solmun oma, vahvistamaton raportti — mitä se kertoo itsestään, ei sitä mistä verkko on päässyt yksimielisyyteen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sariling ulat ng node, hindi pa na-verify — ang sinasabi nito tungkol sa sarili, hindi ang napagkasunduan ng network."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rapport du nœud lui-même, non vérifié — ce qu'il dit de lui, pas ce sur quoi le réseau s'est accordé."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlastito, nepotvrđeno izvješće čvora — ono što kaže o sebi, a ne ono oko čega se mreža složila."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A csomópont saját, ellenőrizetlen jelentése — amit magáról mond, nem az, amiben a hálózat megegyezett."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laporan node itu sendiri, belum terverifikasi — apa yang dikatakannya tentang dirinya, bukan apa yang telah disepakati jaringan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il resoconto del nodo stesso, non verificato — ciò che dice di sé, non ciò su cui la rete ha trovato accordo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノード自身による未検証の申告 — ネットワークが合意した内容ではなく、ノードが自分について述べている内容です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노드가 스스로 보고한 미검증 정보 — 네트워크가 합의한 내용이 아니라 노드가 자신에 대해 말하는 내용입니다."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сопствениот, непроверен извештај на јазолот — она што го кажува за себе, а не она за што мрежата се согласила."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laporan nod itu sendiri, belum disahkan — apa yang dikatakannya tentang dirinya, bukan apa yang telah dipersetujui oleh rangkaian."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nodens egen, ubekreftede rapport — hva den sier om seg selv, ikke hva nettverket har blitt enige om."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het eigen, niet-geverifieerde rapport van de node — wat hij over zichzelf zegt, niet waar het netwerk het over eens is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Własny, niezweryfikowany raport węzła — to, co mówi o sobie, a nie to, co uzgodniła sieć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O relato do próprio nó, não verificado — o que ele diz sobre si mesmo, não o que a rede acordou."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raportul propriu al nodului, neverificat — ce spune despre sine, nu ceea ce a stabilit rețeaua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Собственный непроверенный отчёт ноды — то, что она сообщает о себе, а не то, о чём договорилась сеть."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlastné neoverené hlásenie uzla — to, čo hovorí sám o sebe, nie to, na čom sa zhodla sieť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lastno, nepreverjeno poročilo vozlišča — kar pravi o sebi, ne to, o čemer se je omrežje sporazumelo."
          }
        },
        "sl_SI" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lastno, nepreverjeno poročilo vozlišča — kar pravi o sebi, ne to, o čemer se je omrežje sporazumelo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raporti i vetë nyjes, i paverifikuar — ajo që thotë për veten, jo ajo për të cilën rrjeti është dakordësuar."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sopstveni, nepotvrđeni izveštaj čvora — ono što kaže o sebi, a ne ono oko čega se mreža složila."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nodens egen, overifierade rapport — vad den säger om sig själv, inte vad nätverket har enats om."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายงานของโหนดเอง ยังไม่ผ่านการตรวจสอบ — คือสิ่งที่โหนดบอกเกี่ยวกับตัวเอง ไม่ใช่สิ่งที่เครือข่ายเห็นพ้อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düğümün doğrulanmamış kendi raporu — ağın üzerinde anlaştığı şey değil, düğümün kendisi hakkında söyledikleri."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Власний неперевірений звіт ноди — те, що вона повідомляє про себе, а не те, про що домовилася мережа."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Báo cáo của chính nút, chưa được kiểm chứng — là điều nút tự nói về mình, không phải điều mạng đã thống nhất."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "节点自报的未经验证的信息——是它对自己的说法，而非网络已达成一致的结果。"
