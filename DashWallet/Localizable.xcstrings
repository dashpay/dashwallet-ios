    "Finds owner and payout keys, which aren't in the masternode list. Sends the key's public fingerprint to a Platform node." : {
      "comment" : "Add masternode",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعثر على مفتاحَي المالك والدفع، وهما ليسا في قائمة العُقد الرئيسية. يرسل البصمة العامة للمفتاح إلى عقدة Platform."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Намира ключове на собственика и за изплащане, които не са в списъка с мастърнодове. Изпраща публичния отпечатък на ключа до възел на Platform."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troba les claus de propietari i de pagament, que no són a la llista de masternodes. Envia l'empremta pública de la clau a un node de Platform."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najde klíče vlastníka a výplaty, které v seznamu masternodů nejsou. Odešle veřejný otisk klíče na uzel Platform."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder ejer- og udbetalingsnøgler, som ikke står på masternode-listen. Sender nøglens offentlige fingeraftryk til en Platform-node."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Findet Besitzer- und Auszahlungsschlüssel, die nicht in der Masternode-Liste stehen. Sendet den öffentlichen Fingerabdruck des Schlüssels an eine Platform-Node."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βρίσκει κλειδιά ιδιοκτήτη και πληρωμής που δεν υπάρχουν στη λίστα masternode. Στέλνει το δημόσιο αποτύπωμα του κλειδιού σε έναν κόμβο Platform."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finds owner and payout keys, which aren't in the masternode list. Sends the key's public fingerprint to a Platform node."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trovas la ŝlosilojn de posedanto kaj pago, kiuj ne estas en la masternoda listo. Sendas la publikan fingropremon de la ŝlosilo al Platform-nodo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra las claves de propietario y de pago, que no están en la lista de masternodes. Envía la huella pública de la clave a un nodo de Platform."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leiab omaniku ja väljamakse võtmed, mida masternode'ide loendis pole. Saadab võtme avaliku sõrmejälje Platformi sõlmele."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کلیدهای مالک و پرداخت را که در فهرست مسترنودها نیستند پیدا می‌کند. اثر انگشت عمومی کلید را به یک گره Platform می‌فرستد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etsii omistajan ja maksun avaimet, joita ei ole masternode-luettelossa. Lähettää avaimen julkisen sormenjäljen Platform-solmulle."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naghahanap ng owner at payout key, na wala sa listahan ng masternode. Ipinapadala ang public fingerprint ng key sa isang Platform node."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouve les clés de propriétaire et de paiement, qui ne figurent pas dans la liste des masternodes. Envoie l'empreinte publique de la clé à un nœud Platform."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pronalazi ključeve vlasnika i isplate kojih nema na popisu masternodova. Šalje javni otisak ključa Platform čvoru."
