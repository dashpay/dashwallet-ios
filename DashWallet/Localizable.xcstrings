        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khoản thanh toán của bạn đã được gửi, nhưng mạng chưa xác nhận. Thẻ quà tặng của bạn sẽ xuất hiện ngay khi được xác nhận."
          }
        },
        "zh" : {
          "stringUnit" : {
