    "Transaction removed — rescan couldn't start, run Rescan Filters in Core Sync Status" : {
      "comment" : "Remove never-accepted transaction: removed but the recovery rescan did not arm",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُزيلت المعاملة — تعذّر بدء إعادة الفحص، شغّل «إعادة فحص المرشّحات» في حالة مزامنة Core"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Транзакцията е премахната — повторното сканиране не можа да започне, изпълнете „Повторно сканиране на филтрите“ в Състояние на синхронизацията на Core"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transacció eliminada — el reescaneig no s'ha pogut iniciar, executa «Reescaneja els filtres» a l'Estat de sincronització del Core"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transakce odstraněna — opětovné prohledání se nepodařilo spustit, spusťte „Znovu prohledat filtry“ ve Stavu synchronizace Core"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transaktion fjernet — genscanningen kunne ikke starte, kør “Genscan filtre” i Core-synkroniseringsstatus"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transaktion entfernt — Rescan konnte nicht gestartet werden, führe „Filter neu scannen“ im Core-Sync-Status aus"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η συναλλαγή αφαιρέθηκε — η επανασάρωση δεν ξεκίνησε, εκτελέστε το «Επανασάρωση φίλτρων» στην Κατάσταση συγχρονισμού Core"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transaction removed — rescan couldn't start, run Rescan Filters in Core Sync Status"
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transakcio forigita — la reskanado ne povis komenciĝi, rulu „Reskani filtrilojn“ en la stato de Core-sinkronigo"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transacción eliminada — no se pudo iniciar el reescaneo, ejecuta «Reescanear filtros» en el Estado de sincronización de Core"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tehing eemaldatud — uuesti skannimine ei käivitunud, käivita „Skanni filtrid uuesti“ Core'i sünkroonimise olekus"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تراکنش حذف شد — پویش دوباره آغاز نشد، «پویش دوباره فیلترها» را در وضعیت همگام‌سازی Core اجرا کنید"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapahtuma poistettu — uudelleenskannaus ei käynnistynyt, suorita ”Skannaa suodattimet uudelleen” Core-synkronoinnin tilassa"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inalis ang transaksyon — hindi nasimulan ang rescan, patakbuhin ang “I-rescan ang mga Filter” sa Core Sync Status"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
