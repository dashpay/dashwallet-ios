    "Could not save a key to the keychain. Nothing was lost — try again." : {
      "comment" : "Add masternode",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر حفظ مفتاح في سلسلة المفاتيح. لم يُفقد شيء — أعد المحاولة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключът не можа да бъде запазен в keychain. Нищо не е загубено — опитайте отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha pogut desar una clau al clauer. No s'ha perdut res — torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klíč se nepodařilo uložit do keychainu. Nic se neztratilo — zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En nøgle kunne ikke gemmes i keychain. Intet gik tabt — prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Schlüssel konnte nicht in der Keychain gespeichert werden. Es ging nichts verloren — versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η αποθήκευση ενός κλειδιού στο keychain. Δεν χάθηκε τίποτα — δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not save a key to the keychain. Nothing was lost — try again."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ŝlosilo ne povis esti konservita en la ŝlosilaro. Nenio perdiĝis — reprovu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar una clave en el llavero. No se perdió nada — inténtalo de nuevo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Võtit ei õnnestunud võtmehoidjasse salvestada. Midagi ei läinud kaotsi — proovi uuesti."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ذخیره کلید در کی‌چین ممکن نشد. چیزی از دست نرفت — دوباره تلاش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avainta ei voitu tallentaa avainnippuun. Mitään ei kadonnut — yritä uudelleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi na-save ang isang key sa keychain. Walang nawala — subukan ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'enregistrer une clé dans le trousseau. Rien n'a été perdu — réessayez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ključ nije bilo moguće spremiti u keychain. Ništa nije izgubljeno — pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy kulcsot nem sikerült elmenteni a kulcstartóba. Semmi sem veszett el — próbáld újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci tidak dapat disimpan ke keychain. Tidak ada yang hilang — coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile salvare una chiave nel portachiavi. Non è andato perso nulla — riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーをキーチェーンに保存できませんでした。失われたものはありません — 再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키를 키체인에 저장하지 못했습니다. 손실된 것은 없습니다 — 다시 시도하세요."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клучот не можеше да се зачува во keychain. Ништо не е изгубено — обидете се повторно."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
