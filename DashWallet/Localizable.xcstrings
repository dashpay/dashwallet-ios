    "The seller changed the price before your purchase was accepted. Review the new price and try again." : {
      "comment" : "Username marketplace",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غيّر البائع السعر قبل قبول عملية الشراء. راجع السعر الجديد وأعد المحاولة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продавачът промени цената, преди покупката ви да бъде приета. Прегледайте новата цена и опитайте отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El venedor ha canviat el preu abans que s'acceptés la teva compra. Revisa el preu nou i torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prodávající změnil cenu dříve, než byl váš nákup přijat. Zkontrolujte novou cenu a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sælgeren ændrede prisen, før dit køb blev accepteret. Gennemse den nye pris, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Verkäufer hat den Preis geändert, bevor dein Kauf angenommen wurde. Prüfe den neuen Preis und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο πωλητής άλλαξε την τιμή πριν γίνει δεκτή η αγορά σας. Ελέγξτε τη νέα τιμή και δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The seller changed the price before your purchase was accepted. Review the new price and try again."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vendanto ŝanĝis la prezon antaŭ ol via aĉeto estis akceptita. Kontrolu la novan prezon kaj reprovu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El vendedor cambió el precio antes de que se aceptara tu compra. Revisa el nuevo precio e inténtalo de nuevo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Müüja muutis hinda enne, kui sinu ost vastu võeti. Vaata uus hind üle ja proovi uuesti."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فروشنده پیش از پذیرفته‌شدن خرید شما قیمت را تغییر داد. قیمت جدید را بررسی و دوباره تلاش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myyjä muutti hintaa ennen kuin ostosi hyväksyttiin. Tarkista uusi hinta ja yritä uudelleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binago ng nagbebenta ang presyo bago tanggapin ang iyong pagbili. Suriin ang bagong presyo at subukan ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le vendeur a modifié le prix avant que votre achat ne soit accepté. Vérifiez le nouveau prix et réessayez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prodavatelj je promijenio cijenu prije nego što je vaša kupnja prihvaćena. Pregledajte novu cijenu i pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az eladó módosította az árat, mielőtt a vásárlásodat elfogadták volna. Nézd meg az új árat, és próbáld újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penjual mengubah harga sebelum pembelian Anda diterima. Tinjau harga baru lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il venditore ha cambiato il prezzo prima che il tuo acquisto fosse accettato. Controlla il nuovo prezzo e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの購入が受理される前に、出品者が価格を変更しました。新しい価格を確認して再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구매가 수락되기 전에 판매자가 가격을 변경했습니다. 새 가격을 확인하고 다시 시도하세요."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продавачот ја смени цената пред вашата купувачка да биде прифатена. Прегледајте ја новата цена и обидете се повторно."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penjual menukar harga sebelum pembelian anda diterima. Semak harga baharu dan cuba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selgeren endret prisen før kjøpet ditt ble godtatt. Se over den nye prisen og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verkoper heeft de prijs gewijzigd voordat je aankoop werd geaccepteerd. Bekijk de nieuwe prijs en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprzedający zmienił cenę, zanim Twój zakup został przyjęty. Sprawdź nową cenę i spróbuj ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O vendedor alterou o preço antes de sua compra ser aceita. Revise o novo preço e tente novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vânzătorul a schimbat prețul înainte ca achiziția ta să fie acceptată. Verifică noul preț și încearcă din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продавец изменил цену до того, как ваша покупка была принята. Проверьте новую цену и попробуйте снова."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predávajúci zmenil cenu skôr, ako bol váš nákup prijatý. Skontrolujte novú cenu a skúste to znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prodajalec je spremenil ceno, preden je bil vaš nakup sprejet. Preglejte novo ceno in poskusite znova."
          }
        },
        "sl_SI" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prodajalec je spremenil ceno, preden je bil vaš nakup sprejet. Preglejte novo ceno in poskusite znova."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shitësi ndryshoi çmimin para se blerja jote të pranohej. Shiko çmimin e ri dhe provo përsëri."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prodavac je promenio cenu pre nego što je vaša kupovina prihvaćena. Pregledajte novu cenu i pokušajte ponovo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säljaren ändrade priset innan ditt köp godkändes. Granska det nya priset och försök igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผู้ขายเปลี่ยนราคาก่อนที่การซื้อของคุณจะได้รับการยอมรับ ตรวจสอบราคาใหม่แล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satıcı, satın alma işleminiz kabul edilmeden önce fiyatı değiştirdi. Yeni fiyatı inceleyip yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продавець змінив ціну до того, як вашу покупку було прийнято. Перевірте нову ціну і спробуйте знову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Người bán đã đổi giá trước khi giao dịch mua của bạn được chấp nhận. Hãy xem giá mới và thử lại."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你的购买被接受之前，卖家更改了价格。请查看新价格后重试。"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你的購買被接受之前，賣家更改了價格。請查看新價格後再試。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你的购买被接受之前，卖家更改了价格。请查看新价格后重试。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你的購買被接受之前，賣家更改了價格。請查看新價格後再試。"
