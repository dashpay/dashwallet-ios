            }
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forĵetitaj %lld nekonfirmitaj transakcioj, sed la reskanado de filtriloj ne povis komenciĝi — rulu „Reskani filtrilojn“ supre."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se descartaron %lld transacción(es) sin confirmar, pero no se pudo iniciar el reescaneo de filtros — ejecuta «Reescanear filtros» arriba."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loobuti %lld kinnitamata tehingust, kuid filtrite uuesti skannimine ei käivitunud — käivita ülal „Skanni filtrid uuesti“."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%lld تراکنش تأییدنشده دور انداخته شد، اما پویش دوباره فیلترها آغاز نشد — «پویش دوباره فیلترها» را در بالا اجرا کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hylättiin %lld vahvistamatonta tapahtumaa, mutta suodattimien uudelleenskannaus ei käynnistynyt — suorita yllä ”Skannaa suodattimet uudelleen”."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na-drop ang %lld hindi pa nakumpirmang transaksyon, pero hindi nasimulan ang filter rescan — patakbuhin ang “I-rescan ang mga Filter” sa itaas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld transaction(s) non confirmée(s) abandonnée(s), mais le rescan des filtres n'a pas pu démarrer — lancez « Rescanner les filtres » ci-dessus."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odbačeno nepotvrđenih transakcija: %lld, ali ponovno skeniranje filtara nije moglo započeti — pokrenite „Ponovno skeniraj filtre“ iznad."
          }
        },
        "hu" : {
          "stringUnit" : {
