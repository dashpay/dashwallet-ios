    "A single wallet's recovery phrase cannot authorize deleting multiple different wallets." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن لعبارة استرداد محفظة واحدة أن تصرّح بحذف عدة محافظ مختلفة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фразата за възстановяване на един портфейл не може да разреши изтриването на няколко различни портфейла."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La frase de recuperació d'una sola cartera no pot autoritzar la supressió de diverses carteres diferents."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
