    "No usernames on this identity yet. Find one to buy or register on the Find Names tab." : {
      "comment" : "Username marketplace: empty owned list",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد أسماء مستخدمين على هذه الهوية بعد. ابحث عن اسم لشرائه أو تسجيله في تبويب «البحث عن الأسماء»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тази самоличност още няма потребителски имена. Намерете име за купуване или регистриране в раздела „Търсене на имена“."
          }
        },
        "ca" : {
