        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your device time is %1$@ by %2$#@seconds@. You cannot use CoinJoin due to this difference.\n\nThe time settings on your device needs to be changed to “Set time automatically” to use CoinJoin."
