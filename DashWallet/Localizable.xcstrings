    "Fees are taken from the amount; from Shielded, a small remainder may stay in your Platform balance." : {
      "comment" : "Identity top-up sheet — fee note",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُخصم الرسوم من المبلغ؛ وعند الدفع من Shielded قد يبقى مبلغ صغير في رصيد Platform لديك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таксите се удържат от сумата; при плащане от Shielded малък остатък може да остане в баланса ви в Platform."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les comissions es descompten de l'import; des de Shielded, pot quedar un petit romanent al teu saldo de Platform."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poplatky se strhávají z částky; při platbě ze Shielded může malý zbytek zůstat na vašem zůstatku Platform."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebyrerne trækkes fra beløbet; fra Shielded kan en lille rest blive tilbage på din Platform-saldo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gebühren werden vom Betrag abgezogen; bei Shielded kann ein kleiner Rest in deinem Platform-Guthaben verbleiben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα τέλη αφαιρούνται από το ποσό· από το Shielded, ένα μικρό υπόλοιπο μπορεί να παραμείνει στο υπόλοιπό σας στο Platform."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fees are taken from the amount; from Shielded, a small remainder may stay in your Platform balance."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La kotizoj estas deprenataj de la sumo; el Shielded, malgranda restaĵo povas resti sur via Platform-saldo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las comisiones se descuentan del importe; desde Shielded, puede quedar un pequeño resto en tu saldo de Platform."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasud arvestatakse summast maha; Shieldedilt makstes võib väike jääk jääda sinu Platformi jäägile."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کارمزدها از مبلغ کسر می‌شوند؛ در پرداخت از Shielded ممکن است باقیمانده کوچکی در موجودی Platform شما بماند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksukulut vähennetään summasta; Shielded-saldosta maksettaessa pieni jäännös voi jäädä Platform-saldoosi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kinukuha ang mga bayarin mula sa halaga; mula sa Shielded, maaaring may maliit na natira sa iyong balanse sa Platform."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les frais sont prélevés sur le montant ; depuis Shielded, un petit reliquat peut rester sur votre solde Platform."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naknade se oduzimaju od iznosa; pri plaćanju iz Shielded mali ostatak može ostati na vašem Platform stanju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A díjakat az összegből vonjuk le; Shielded egyenlegről fizetve kis maradék maradhat a Platform-egyenlegeden."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biaya dipotong dari jumlahnya; dari Shielded, sisa kecil mungkin tertinggal di saldo Platform Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le commissioni vengono prelevate dall'importo; partendo da Shielded, un piccolo resto può rimanere sul tuo saldo Platform."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手数料は金額から差し引かれます。Shielded から支払う場合、わずかな残りが Platform 残高に残ることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수수료는 금액에서 차감됩니다. Shielded에서 보내면 소액의 잔여분이 Platform 잔액에 남을 수 있습니다."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таксите се одземаат од износот; при плаќање од Shielded, мал остаток може да остане на вашето салдо на Platform."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yuran ditolak daripada jumlahnya; daripada Shielded, baki kecil mungkin tertinggal dalam baki Platform anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebyrene trekkes fra beløpet; fra Shielded kan en liten rest bli igjen på Platform-saldoen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kosten worden van het bedrag afgehaald; vanuit Shielded kan een klein restant op je Platform-saldo achterblijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opłaty są pobierane z kwoty; przy płatności z Shielded niewielka reszta może pozostać na Twoim saldzie Platform."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As taxas são descontadas do valor; a partir do Shielded, um pequeno resto pode permanecer no seu saldo da Platform."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taxele se scad din sumă; plătind din Shielded, un rest mic poate rămâne în soldul tău Platform."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Комиссии удерживаются из суммы; при оплате из Shielded небольшой остаток может остаться на вашем балансе Platform."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poplatky sa strhávajú zo sumy; pri platbe zo Shielded môže malý zvyšok zostať na vašom zostatku Platform."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provizije se odštejejo od zneska; pri plačilu iz Shielded lahko majhen ostanek ostane na vašem stanju Platform."
          }
        },
        "sl_SI" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provizije se odštejejo od zneska; pri plačilu iz Shielded lahko majhen ostanek ostane na vašem stanju Platform."
          }
        },
