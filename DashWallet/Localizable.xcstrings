    "That could also be an owner or payout key — turn on “Search Platform too” to check." : {
      "comment" : "Add masternode",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يكون ذلك أيضًا مفتاح مالك أو مفتاح دفع — فعّل «البحث في Platform أيضًا» للتحقق."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това може да е и ключ на собственика или за изплащане — включете „Търсене и в Platform“, за да проверите."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això també podria ser una clau de propietari o de pagament — activa «Cerca també a Platform» per comprovar-ho."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Může to být i klíč vlastníka nebo výplaty — zapněte „Hledat i na Platform“ a ověřte to."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det kan også være en ejer- eller udbetalingsnøgle — slå “Søg også på Platform” til for at tjekke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das könnte auch ein Besitzer- oder Auszahlungsschlüssel sein — aktiviere „Auch Platform durchsuchen“, um das zu prüfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό θα μπορούσε επίσης να είναι κλειδί ιδιοκτήτη ή πληρωμής — ενεργοποιήστε την «Αναζήτηση και στο Platform» για να ελέγξετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That could also be an owner or payout key — turn on “Search Platform too” to check."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tio povus esti ankaŭ ŝlosilo de posedanto aŭ de pago — ŝaltu „Serĉi ankaŭ en Platform“ por kontroli."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eso también podría ser una clave de propietario o de pago — activa «Buscar también en Platform» para comprobarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See võib olla ka omaniku või väljamakse võti — kontrollimiseks lülita sisse „Otsi ka Platformist“."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آن می‌تواند کلید مالک یا پرداخت هم باشد — برای بررسی «جست‌وجو در Platform نیز» را روشن کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se voi olla myös omistajan tai maksun avain — tarkista ottamalla käyttöön ”Hae myös Platformista”."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puwede rin iyang owner o payout key — i-on ang “Maghanap din sa Platform” para suriin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela pourrait aussi être une clé de propriétaire ou de paiement — activez « Chercher aussi sur Platform » pour vérifier."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To može biti i ključ vlasnika ili isplate — uključite „Pretraži i Platform“ da biste provjerili."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez lehet tulajdonosi vagy kifizetési kulcs is — kapcsold be a „Keresés a Platformon is” lehetőséget az ellenőrzéshez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itu bisa juga kunci pemilik atau pembayaran — nyalakan “Cari di Platform juga” untuk memeriksanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrebbe anche essere una chiave del proprietario o di pagamento — attiva «Cerca anche su Platform» per verificarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それはオーナー キーまたは支払キーの可能性もあります — 「Platform も検索する」をオンにして確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소유자 키나 지급 키일 수도 있습니다 — ‘Platform도 검색’을 켜서 확인하세요."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тоа може да биде и клуч на сопственикот или за исплата — вклучете „Барај и на Platform“ за да проверите."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itu juga boleh jadi kunci pemilik atau pembayaran — hidupkan “Cari di Platform juga” untuk menyemaknya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det kan også være en eier- eller utbetalingsnøkkel — slå på «Søk også på Platform» for å sjekke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat kan ook een eigenaars- of uitbetaalsleutel zijn — zet ‘Ook op Platform zoeken’ aan om dat te controleren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To może być również klucz właściciela lub wypłaty — włącz „Szukaj też na Platform”, aby sprawdzić."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso também pode ser uma chave de proprietário ou de pagamento — ative “Buscar também na Platform” para verificar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceea ar putea fi și o cheie de proprietar sau de plată — activează „Caută și pe Platform” pentru a verifica."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это также может быть ключ владельца или платёжного адреса — включите «Искать также в Platform», чтобы проверить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Môže to byť aj kľúč vlastníka alebo výplaty — zapnite „Hľadať aj na Platform“ a overte to."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To je lahko tudi ključ lastnika ali izplačila — vklopite „Išči tudi na Platform“, da preverite."
          }
        },
        "sl_SI" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To je lahko tudi ključ lastnika ali izplačila — vklopite „Išči tudi na Platform“, da preverite."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ai mund të jetë edhe një çelës pronari ose pagese — aktivizo „Kërko edhe në Platform“ për ta kontrolluar."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To može biti i ključ vlasnika ili isplate — uključite „Pretraži i Platform“ da biste proverili."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det kan också vara en ägar- eller utbetalningsnyckel — slå på ”Sök även på Platform” för att kontrollera."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นั่นอาจเป็นคีย์เจ้าของหรือคีย์รับเงินก็ได้ — เปิด “ค้นหาใน Platform ด้วย” เพื่อตรวจสอบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bir sahip veya ödeme anahtarı da olabilir — kontrol etmek için “Platform'da da ara” seçeneğini açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це також може бути ключ власника або платіжної адреси — увімкніть «Шукати також у Platform», щоб перевірити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đó cũng có thể là khoá chủ sở hữu hoặc khoá chi trả — hãy bật “Tìm cả trên Platform” để kiểm tra."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那也可能是所有者密钥或付款密钥——请打开“同时搜索 Platform”进行检查。"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那也可能是擁有者鑰匙或付款鑰匙——請開啟「同時搜尋 Platform」進行檢查。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那也可能是所有者密钥或付款密钥——请打开“同时搜索 Platform”进行检查。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那也可能是擁有者鑰匙或付款鑰匙——請開啟「同時搜尋 Platform」進行檢查。"
          }
        }
      }
    },
