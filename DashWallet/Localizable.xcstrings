    "Voting on “%@” has already closed. Refresh to see the result." : {
      "comment" : "Voting",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُغلق التصويت على ”%@“ بالفعل. حدّث لعرض النتيجة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гласуването за „%@“ вече е затворено. Опреснете, за да видите резултата."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La votació sobre «%@» ja s'ha tancat. Actualitza per veure el resultat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hlasování o „%@“ již bylo uzavřeno. Obnovte, abyste viděli výsledek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afstemningen om “%@” er allerede lukket. Opdater for at se resultatet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Abstimmung über „%@“ ist bereits geschlossen. Aktualisiere, um das Ergebnis zu sehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ψηφοφορία για το «%@» έχει ήδη κλείσει. Ανανεώστε για να δείτε το αποτέλεσμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voting on “%@” has already closed. Refresh to see the result."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voĉdonado pri „%@“ jam fermiĝis. Refreŝigu por vidi la rezulton."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La votación sobre «%@» ya se ha cerrado. Actualiza para ver el resultado."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hääletamine nime „%@“ üle on juba suletud. Tulemuse nägemiseks värskenda."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رأی‌گیری درباره «%@» پیش‌تر بسته شده است. برای دیدن نتیجه به‌روزرسانی کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äänestys kohteesta ”%@” on jo suljettu. Päivitä nähdäksesi tuloksen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sarado na ang pagboto sa “%@”. Mag-refresh para makita ang resulta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le vote sur « %@ » est déjà clos. Actualisez pour voir le résultat."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glasanje o „%@“ već je zatvoreno. Osvježite da biste vidjeli rezultat."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) „%@” szavazása már lezárult. Frissíts az eredmény megtekintéséhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemungutan suara untuk “%@” sudah ditutup. Segarkan untuk melihat hasilnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il voto su «%@» è già chiuso. Aggiorna per vedere il risultato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」の投票はすでに終了しています。更新して結果をご確認ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”에 대한 투표가 이미 마감되었습니다. 새로 고쳐 결과를 확인하세요."
          }
