    "These funds move to your Platform balance and are ready to spend as soon as the transfer completes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنتقل هذه الأموال إلى رصيد Platform وتصبح جاهزة للإنفاق بمجرد اكتمال التحويل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тези средства преминават към вашия баланс в Platform и са готови за харчене веднага щом преводът приключи."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquests fons passen al teu saldo de Platform i estan a punt per gastar tan bon punt es completi la transferència."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyto prostředky přejdou na váš zůstatek Platform a budou připraveny k použití, jakmile se převod dokončí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse midler flyttes til din Platform-saldo og er klar til brug, så snart overførslen er gennemført."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Mittel werden in dein Platform-Guthaben verschoben und stehen zum Ausgeben bereit, sobald der Transfer abgeschlossen ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτά τα κεφάλαια μεταφέρονται στο υπόλοιπο Platform και είναι έτοιμα για δαπάνη μόλις ολοκληρωθεί η μεταφορά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These funds move to your Platform balance and are ready to spend as soon as the transfer completes."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ĉi tiuj monrimedoj transiras al via Platform-saldo kaj pretas por elspezo tuj kiam la transpago finiĝos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos fondos se mueven a tu saldo de Platform y estarán listos para gastar en cuanto se complete la transferencia."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Need vahendid liiguvad su Platformi jääki ja on kulutamiseks valmis kohe, kui ülekanne lõpeb."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این وجوه به موجودی Platform شما می‌روند و به‌محض تکمیل انتقال آماده خرج‌اند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nämä varat siirtyvät Platform-saldoosi ja ovat käytettävissä heti, kun siirto on valmis."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napupunta ang pondong ito sa iyong balanse sa Platform at handa nang gastusin sa oras na matapos ang paglilipat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces fonds sont transférés vers votre solde Platform et seront dépensables dès que le transfert sera terminé."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta sredstva prelaze na vaše Platform stanje i spremna su za trošenje čim se prijenos dovrši."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a pénz átkerül a Platform-egyenlegedre, és az átutalás befejeztével azonnal elkölthető."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dana ini berpindah ke saldo Platform Anda dan siap dibelanjakan begitu transfer selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi fondi si spostano nel tuo saldo Platform e sono pronti da spendere non appena il trasferimento è completato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この資金は Platform 残高へ移り、送金が完了するとすぐに使えるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 자금은 Platform 잔액으로 옮겨지며, 전송이 완료되는 즉시 사용할 수 있습니다."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Овие средства преминуваат во вашето Platform салдо и се спремни за трошење штом преносот заврши."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dana ini berpindah ke baki Platform anda dan sedia untuk dibelanjakan sebaik sahaja pemindahan selesai."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse midlene flyttes til Platform-saldoen din og er klare til bruk så snart overføringen er fullført."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit tegoed gaat naar je Platform-saldo en is klaar om uit te geven zodra de overboeking is voltooid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te środki trafiają na Twoje saldo Platform i będą gotowe do wydania, gdy tylko transfer się zakończy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes fundos vão para o seu saldo da Platform e ficam prontos para gastar assim que a transferência for concluída."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceste fonduri trec în soldul tău Platform și sunt gata de cheltuit imediat ce transferul se finalizează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти средства переходят на ваш баланс Platform и готовы к трате, как только перевод завершится."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieto prostriedky prejdú na váš zostatok Platform a budú pripravené na použitie hneď po dokončení prevodu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta sredstva se prenesejo v vaše stanje Platform in so pripravljena za porabo, takoj ko se prenos zaključi."
          }
        },
        "sl_SI" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta sredstva se prenesejo v vaše stanje Platform in so pripravljena za porabo, takoj ko se prenos zaključi."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Këto fonde kalojnë te balanca juaj Platform dhe janë gati për t'u shpenzuar sapo transferimi të përfundojë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova sredstva prelaze na vaše Platform stanje i spremna su za trošenje čim se prenos završi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De här medlen flyttas till ditt Platform-saldo och är redo att användas så snart överföringen är klar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เงินนี้จะย้ายไปยังยอดคงเหลือ Platform ของคุณ และพร้อมใช้จ่ายทันทีที่การโอนเสร็จสมบูรณ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu fonlar Platform bakiyenize geçer ve transfer tamamlanır tamamlanmaz harcanmaya hazır olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ці кошти переходять на ваш баланс Platform і готові до витрачання, щойно переказ завершиться."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số tiền này chuyển vào số dư Platform của bạn và sẵn sàng để chi tiêu ngay khi việc chuyển hoàn tất."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些资金将转入您的 Platform 余额，转账完成后即可使用。"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些資金將轉入您的 Platform 餘額，轉帳完成後即可使用。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些资金将转入您的 Platform 余额，转账完成后即可使用。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些資金將轉入您的 Platform 餘額，轉帳完成後即可使用。"
          }
        }
      }
