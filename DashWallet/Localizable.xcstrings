    "Could not load the node's registration details — owner and payout keys will verify later." : {
      "comment" : "Add masternode",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تحميل بيانات تسجيل العقدة — سيجري التحقق من مفتاحَي المالك والدفع لاحقًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Регистрационните данни на възела не можаха да бъдат заредени — ключовете на собственика и за изплащане ще бъдат проверени по-късно."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'han pogut carregar les dades de registre del node — les claus de propietari i de pagament es verificaran més endavant."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrační údaje uzlu se nepodařilo načíst — klíče vlastníka a výplaty se ověří později."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nodens registreringsoplysninger kunne ikke indlæses — ejer- og udbetalingsnøgler bekræftes senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Registrierungsdetails der Node konnten nicht geladen werden — Besitzer- und Auszahlungsschlüssel werden später überprüft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η φόρτωση των στοιχείων καταχώρησης του κόμβου — τα κλειδιά ιδιοκτήτη και πληρωμής θα επαληθευτούν αργότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not load the node's registration details — owner and payout keys will verify later."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registraj detaloj de la nodo ne povis esti ŝargitaj — la ŝlosiloj de posedanto kaj pago estos kontrolitaj poste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron cargar los datos de registro del nodo — las claves de propietario y de pago se verificarán más tarde."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sõlme registreerimisandmeid ei õnnestunud laadida — omaniku ja väljamakse võtmed kontrollitakse hiljem."
          }
        },
