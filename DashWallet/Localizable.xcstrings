          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle nime kohta käib masternode'ide hääletus — hääletus lõpeb umbes %@. Uued kandidaadid ei saa selle hääletusega enam liituda."
