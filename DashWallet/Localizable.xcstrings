    "Wallet is not ready. Try again in a moment." : {
      "comment" : "Evonode withdrawal\nMasternode unban",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المحفظة غير جاهزة. أعد المحاولة بعد قليل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Портфейлът не е готов. Опитайте отново след малко."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cartera no està a punt. Torna-ho a provar d'aquí a un moment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peněženka není připravena. Zkuste to za chvíli znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegnebogen er ikke klar. Prøv igen om et øjeblik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wallet ist nicht bereit. Versuche es gleich noch einmal."
          }
        },
