    "Your mixed coins were moved to your Dash Wallet balance." : {
      "comment" : "CoinJoin",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نُقلت عملاتك المخلوطة إلى رصيد محفظة داش."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смесените ви монети бяха преместени в баланса на портфейла Dash."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les teves monedes barrejades s'han mogut al saldo de la teva cartera Dash."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše smíchané mince byly přesunuty do zůstatku peněženky Dash."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine blandede mønter er flyttet til saldoen i din Dash-tegnebog."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine gemixten Coins wurden in dein Dash-Wallet-Guthaben verschoben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα αναμειγμένα νομίσματά σας μεταφέρθηκαν στο υπόλοιπο του πορτοφολιού Dash."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your mixed coins were moved to your Dash Wallet balance."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viaj miksitaj moneroj estis movitaj al la saldo de via monujo Dash."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus monedas mezcladas se movieron al saldo de tu billetera Dash."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su segatud mündid liigutati Dashi rahakoti jääki."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سکه‌های ترکیب‌شده شما به موجودی کیف پول دش منتقل شد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekoitetut kolikkosi siirrettiin Dash-lompakkosi saldoon."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nailipat sa balanse ng iyong Dash Wallet ang pinaghalo mong barya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos pièces mélangées ont été déplacées vers le solde de votre portefeuille Dash."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaši pomiješani novčići premješteni su u stanje vašeg Dash novčanika."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kevert érméidet a Dash-tárcád egyenlegére helyeztük."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koin campuran Anda telah dipindahkan ke saldo Dompet Dash Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue monete miscelate sono state spostate nel saldo del tuo portafoglio Dash."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミキシングしたコインを Dash ウォレットの残高に移動しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "믹싱한 코인을 Dash 지갑 잔액으로 옮겼습니다."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вашите измешани монети се преместени во салдото на вашиот Dash паричник."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syiling campuran anda telah dipindahkan ke baki Dompet Dash anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De blandede myntene dine er flyttet til saldoen i Dash-lommeboken din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gemixte munten zijn verplaatst naar je Dash-portemonneesaldo."
          }
        },
        "pl" : {
