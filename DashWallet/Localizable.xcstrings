    "This applies one choice to all %d selected usernames." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطبّق هذا خيارًا واحدًا على جميع أسماء المستخدمين المحددة البالغ عددها %d."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това прилага един избор върху всички %d избрани потребителски имена."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això aplica una sola opció a tots els %d noms d'usuari seleccionats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto použije jednu volbu na všech %d vybraných uživatelských jmen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette anvender ét valg på alle %d valgte brugernavne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies wendet eine Auswahl auf alle %d ausgewählten Benutzernamen an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό εφαρμόζει μία επιλογή σε όλα τα %d επιλεγμένα ονόματα χρήστη."
