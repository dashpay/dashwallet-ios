    "The recovery phrases stored on this device could not be read. Please try again." : {
      "comment" : "Recovery phrase",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة عبارات الاسترداد المخزَّنة على هذا الجهاز. يُرجى إعادة المحاولة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фразите за възстановяване, запазени на това устройство, не можаха да бъдат прочетени. Опитайте отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'han pogut llegir les frases de recuperació desades en aquest dispositiu. Torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fráze pro obnovení uložené na tomto zařízení se nepodařilo načíst. Zkuste to prosím znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gendannelsessætningerne, der er gemt på denne enhed, kunne ikke læses. Prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die auf diesem Gerät gespeicherten Wiederherstellungs-Wortfolgen konnten nicht gelesen werden. Bitte versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η ανάγνωση των φράσεων ανάκτησης που είναι αποθηκευμένες σε αυτή τη συσκευή. Δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recovery phrases stored on this device could not be read. Please try again."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reakiraj frazoj konservitaj sur ĉi tiu aparato ne povis esti legitaj. Bonvolu reprovi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer las frases de recuperación guardadas en este dispositivo. Inténtalo de nuevo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sellesse seadmesse salvestatud taastefraase ei õnnestunud lugeda. Palun proovi uuesti."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عبارت‌های بازیابی ذخیره‌شده روی این دستگاه خوانده نشدند. لطفاً دوباره تلاش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tälle laitteelle tallennettuja palautuslauseita ei voitu lukea. Yritä uudelleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi nabasa ang mga recovery phrase na nakaimbak sa device na ito. Pakisubukan ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
