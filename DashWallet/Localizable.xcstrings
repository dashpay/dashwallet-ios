        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiunque abbia la tua frase di recupero può accedere ai tuoi fondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復元フレーズを持っている人は誰でもあなたの資金にアクセスできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
