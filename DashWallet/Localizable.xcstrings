          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Платежи с каждым контактом собраны в одном месте — с именами и профилями вместо необработанных транзакций."
          }
        },
        "sk" : {
          "stringUnit" : {
