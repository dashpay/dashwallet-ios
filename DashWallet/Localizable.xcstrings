    "This transaction is confirmed and can't be removed." : {
      "comment" : "Remove never-accepted transaction: local state says it's on-chain",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه المعاملة مؤكدة ولا يمكن إزالتها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тази транзакция е потвърдена и не може да бъде премахната."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta transacció està confirmada i no es pot eliminar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato transakce je potvrzená a nelze ji odstranit."
          }
        },
        "da" : {
          "stringUnit" : {
