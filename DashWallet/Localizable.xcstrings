    "Masternodes and evonodes registered with this wallet's keys will appear here after the wallet syncs." : {
      "comment" : "Masternodes",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستظهر هنا عقد الماسترنود وعقد Evonode المسجّلة بمفاتيح هذه المحفظة بعد مزامنة المحفظة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мастернодите и evonode, регистрирани с ключовете на този портфейл, ще се появят тук след като портфейлът се синхронизира."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els masternodes i evonodes registrats amb les claus d'aquesta cartera apareixeran aquí després que la cartera se sincronitzi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masternody a evonody zaregistrované klíči této peněženky se zde zobrazí po synchronizaci peněženky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masternoder og evonoder, der er registreret med denne tegnebogs nøgler, vises her, når tegnebogen er synkroniseret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masternodes und Evonodes, die mit den Schlüsseln dieser Wallet registriert sind, erscheinen hier, sobald die Wallet synchronisiert ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα masternodes και τα evonodes που έχουν καταχωριστεί με τα κλειδιά αυτού του πορτοφολιού θα εμφανιστούν εδώ μετά τον συγχρονισμό του πορτοφολιού."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masternodes and evonodes registered with this wallet's keys will appear here after the wallet syncs."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masternodoj kaj evonodoj registritaj per la ŝlosiloj de ĉi tiu monujo aperos ĉi tie post kiam la monujo sinkroniĝos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los masternodes y evonodes registrados con las llaves de esta billetera aparecerán aquí después de que la billetera se sincronice."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle rahakoti võtmetega registreeritud masternode'id ja evonode'id ilmuvad siia pärast rahakoti sünkroonimist."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مسترنودها و evonodeهایی که با کلیدهای این کیف پول ثبت شده‌اند پس از همزمان‌سازی کیف پول اینجا نمایان می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämän lompakon avaimilla rekisteröidyt masternodet ja evonodet näkyvät tässä, kun lompakko on synkronoitu."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lilitaw dito ang mga masternode at evonode na nakarehistro sa mga key ng wallet na ito matapos mag-sync ang wallet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les masternodes et evonodes enregistrés avec les clés de ce portefeuille apparaîtront ici une fois le portefeuille synchronisé."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masternodeovi i evonodeovi registrirani ključevima ovog novčanika pojavit će se ovdje nakon što se novčanik sinkronizira."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ennek a tárcának a kulcsaival regisztrált masternode-ok és evonode-ok itt jelennek meg, miután a tárca szinkronizált."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masternode dan evonode yang terdaftar dengan kunci dompet ini akan muncul di sini setelah dompet tersinkronkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I masternode e gli evonode registrati con le chiavi di questo portafoglio compariranno qui dopo la sincronizzazione del portafoglio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このウォレットのキーで登録されたマスターノードと Evonode は、ウォレットの同期後にここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 지갑의 키로 등록된 마스터노드와 Evonode는 지갑 동기화가 끝난 뒤 여기에 표시됩니다."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мастернодите и evonode регистрирани со клучевите на овој паричник ќе се појават овде откако паричникот ќе се синхронизира."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masternode dan evonode yang didaftarkan dengan kunci dompet ini akan muncul di sini selepas dompet disegerakkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masternoder og evonoder som er registrert med nøklene til denne lommeboken, vises her etter at lommeboken har synkronisert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masternodes en evonodes die met de sleutels van deze portemonnee zijn geregistreerd, verschijnen hier nadat de portemonnee is gesynchroniseerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masternody i evonody zarejestrowane kluczami tego portfela pojawią się tutaj po zsynchronizowaniu portfela."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os masternodes e evonodes registrados com as chaves desta carteira aparecerão aqui depois que a carteira sincronizar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masternode-urile și evonode-urile înregistrate cu cheile acestui portofel vor apărea aici după ce portofelul se sincronizează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мастерноды и evonode, зарегистрированные с ключами этого кошелька, появятся здесь после синхронизации кошелька."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masternódy a evonódy zaregistrované kľúčmi tejto peňaženky sa tu zobrazia po synchronizácii peňaženky."
          }
        },
