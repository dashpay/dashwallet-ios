    "Add this node's owner key or payout address key to withdraw from here." : {
      "comment" : "Tracked masternodes",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف مفتاح المالك أو مفتاح عنوان الدفع لهذه العقدة للسحب من هنا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавете ключа на собственика или ключа на адреса за изплащане на този възел, за да теглите оттук."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix la clau de propietari o la clau de l'adreça de pagament d'aquest node per retirar des d'aquí."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte klíč vlastníka nebo klíč výplatní adresy tohoto uzlu, abyste mohli vybírat odsud."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj denne nodes ejernøgle eller nøgle til udbetalingsadressen for at hæve herfra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge den Besitzer-Schlüssel oder den Schlüssel der Auszahlungsadresse dieser Node hinzu, um von hier auszuzahlen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε το κλειδί ιδιοκτήτη ή το κλειδί διεύθυνσης πληρωμής αυτού του κόμβου για ανάληψη από εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add this node's owner key or payout address key to withdraw from here."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aldonu la ŝlosilon de la posedanto aŭ la ŝlosilon de la pagadreso de ĉi tiu nodo por elpreni de ĉi tie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade la clave de propietario o la clave de la dirección de pago de este nodo para retirar desde aquí."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisa selle sõlme omaniku võti või väljamakseaadressi võti, et siit välja võtta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای برداشت از اینجا، کلید مالک یا کلید نشانی پرداخت این گره را اضافه کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää tämän solmun omistajan avain tai maksuosoitteen avain, niin voit nostaa täältä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idagdag ang owner key o ang key ng payout address ng node na ito para makapag-withdraw mula rito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez la clé de propriétaire ou la clé de l'adresse de paiement de ce nœud pour retirer d'ici."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte ključ vlasnika ili ključ adrese za isplatu ovog čvora da biste povlačili odavde."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add hozzá ennek a csomópontnak a tulajdonosi kulcsát vagy a kifizetési címének kulcsát, hogy innen kivehess."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan kunci pemilik atau kunci alamat pembayaran node ini untuk menarik dari sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi la chiave del proprietario o la chiave dell'indirizzo di pagamento di questo nodo per prelevare da qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここから出金するには、このノードのオーナー キーまたは支払アドレス キーを追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서 출금하려면 이 노드의 소유자 키 또는 지급 주소 키를 추가하세요."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додајте го клучот на сопственикот или клучот на адресата за исплата на овој јазол за да повлекувате од тука."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah kunci pemilik atau kunci alamat pembayaran nod ini untuk mengeluarkan dari sini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til denne nodens eiernøkkel eller nøkkel for utbetalingsadressen for å ta ut herfra."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg de eigenaarssleutel of de sleutel van het uitbetaaladres van deze node toe om hier op te nemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj klucz właściciela lub klucz adresu wypłaty tego węzła, aby wypłacać stąd."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione a chave de proprietário ou a chave do endereço de pagamento deste nó para sacar daqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaugă cheia de proprietar sau cheia adresei de plată a acestui nod pentru a retrage de aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
