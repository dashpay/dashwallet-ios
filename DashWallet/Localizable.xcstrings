    "DEVICE SECURITY COMPROMISED\nAny 'jailbreak' app can access any other app's keychain data (and steal your Dash)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DEVICE SECURITY COMPROMISED\nAny 'jailbreak' app can access any other app's keychain data (and steal your Dash)."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "КОМПРОМОМЕТИРАНА Е СИГУРНОСТТА НА УСТРОЙСТВОТО\nВсякакви 'jailbreak' приложения могат да получат ключови данни на други приложения (и да откраднат вашият Dash)."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DEVICE SECURITY COMPROMISED\nAny 'jailbreak' app can access any other app's keychain data (and steal your Dash)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZABEZPEČENÍ ZAŘÍZENÍ KOMPROMITOVÁNO\nJakákoliv ‚jailbreak‘ aplikace může přistupovat k datům jiné aplikace (a ukrást váš Dash)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DEVICE SECURITY COMPROMISED\nAny 'jailbreak' app can access any other app's keychain data (and steal your Dash)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GERÄTESICHERHEIT KOMPROMITTIERT\nJede 'Jailbreak'-App kann auf die Schlüsselbund-Daten jeder anderen App zugreifen (und so Ihre Dash stehlen)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ΑΣΦΑΛΕΙΑ ΤΗΣ ΣΥΣΚΕΥΗΣ ΕΧΕΙ ΤΕΘΕΙ ΣΕ ΚΙΝΔΥΝΟ\nΟποιαδήποτε 'σπασμένη' εφαρμογή μπορεί να έχει πρόσβαση σε οποιαδήποτε άλλης εφαρμογής τα δεδομένα (και να κλέψει τα Dash σας)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DEVICE SECURITY COMPROMISED\nAny 'jailbreak' app can access any other app's keychain data (and steal your Dash)."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DEVICE SECURITY COMPROMISED\nAny 'jailbreak' app can access any other app's keychain data (and steal your Dash)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DISPOSITIVO DE SEGURIDAD DUDOSA\nCualquier aplicación de 'jailbreak' puede acceder a la cadena de datos de otras aplicaciones (y robar tus Dash)."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DEVICE SECURITY COMPROMISED\nAny 'jailbreak' app can access any other app's keychain data (and steal your Dash)."
          }
        },
