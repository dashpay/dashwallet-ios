    "“%@” could not be read as a Dash username." : {
      "comment" : "Voting",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة ”%@“ كاسم مستخدم داش."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ не можа да бъде прочетено като потребителско име в Dash."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha pogut llegir «%@» com a nom d'usuari de Dash."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ se nepodařilo přečíst jako uživatelské jméno Dash."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” kunne ikke læses som et Dash-brugernavn."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ konnte nicht als Dash-Benutzername gelesen werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το «%@» δεν μπόρεσε να διαβαστεί ως όνομα χρήστη Dash."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” could not be read as a Dash username."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ne legeblis kiel Dash-uzantnomo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» no se pudo leer como un nombre de usuario de Dash."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väärtust „%@“ ei õnnestunud lugeda Dashi kasutajanimena."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» به‌عنوان نام کاربری دش خوانده نشد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merkkijonoa ”%@” ei voitu lukea Dash-käyttäjätunnuksena."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi mabasa ang “%@” bilang Dash username."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n'a pas pu être lu comme un nom d'utilisateur Dash."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ nije bilo moguće pročitati kao Dash korisničko ime."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) „%@” nem olvasható Dash-felhasználónévként."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” tidak dapat dibaca sebagai nama pengguna Dash."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile leggere «%@» come nome utente Dash."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」を Dash のユーザー名として読み取れませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”을(를) Dash 사용자 이름으로 읽을 수 없습니다."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ не можеше да се прочита како Dash корисничко име."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
