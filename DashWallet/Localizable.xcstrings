    "The owner of this username has listed it for %@ Dash. You can buy it right now — the price is paid from your wallet balance." : {
      "comment" : "Usernames",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض مالك اسم المستخدم هذا الاسمَ مقابل %@ Dash. يمكنك شراؤه الآن — ويُدفع السعر من رصيد محفظتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Собственикът на това потребителско име го е обявил за %@ Dash. Можете да го купите веднага — цената се плаща от баланса на портфейла ви."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El propietari d'aquest nom d'usuari l'ha publicat per %@ Dash. El pots comprar ara mateix — el preu es paga des del saldo de la teva cartera."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlastník tohoto uživatelského jména je nabídl za %@ Dash. Můžete je koupit hned — cena se hradí ze zůstatku vaší peněženky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejeren af dette brugernavn har sat det til salg for %@ Dash. Du kan købe det med det samme — prisen betales fra din tegnebogssaldo."
          }
        },
        "de" : {
