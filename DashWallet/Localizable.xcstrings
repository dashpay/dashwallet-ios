    "%@ couldn't be found on the Dash network to send them a contact request." : {
      "comment" : "DashPay Invitations",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر العثور على %@ على شبكة داش لإرسال طلب جهة اتصال إليه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не беше намерен в мрежата Dash, за да му бъде изпратена заявка за контакт."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha pogut trobar %@ a la xarxa Dash per enviar-li una sol·licitud de contacte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uživatele %@ se v síti Dash nepodařilo najít, takže mu nelze poslat žádost o přidání mezi kontakty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kunne ikke findes på Dash-netværket, så der kan ikke sendes en kontaktanmodning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konnte im Dash-Netzwerk nicht gefunden werden, um eine Kontaktanfrage zu senden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο χρήστης %@ δεν βρέθηκε στο δίκτυο Dash για να του σταλεί αίτημα επαφής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
