    "The masternode vote for this name has ended and the result is being finalized. Check back soon." : {
      "comment" : "Usernames",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهى تصويت العُقد الرئيسية على هذا الاسم ويجري الآن حسم النتيجة. تحقق مجددًا قريبًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гласуването на мастърнодовете за това име приключи и резултатът се финализира. Проверете отново скоро."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La votació de masternodes per a aquest nom ha acabat i el resultat s'està finalitzant. Torna-hi aviat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hlasování masternodů o tomto jménu skončilo a výsledek se dokončuje. Podívejte se znovu za chvíli."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masternode-afstemningen om dette navn er slut, og resultatet gøres endeligt op. Kig forbi igen snart."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Masternode-Abstimmung für diesen Namen ist beendet und das Ergebnis wird finalisiert. Schau bald wieder vorbei."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ψηφοφορία masternode για αυτό το όνομα έληξε και το αποτέλεσμα οριστικοποιείται. Ελέγξτε ξανά σύντομα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The masternode vote for this name has ended and the result is being finalized. Check back soon."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voĉdonado de masternodoj pri ĉi tiu nomo finiĝis kaj la rezulto estas finpretigata. Rekontrolu baldaŭ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La votación de masternodes para este nombre ha terminado y se está finalizando el resultado. Vuelve pronto."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle nime masternode'ide hääletus on lõppenud ja tulemust vormistatakse. Vaata peagi uuesti."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رأی‌گیری مسترنودها برای این نام پایان یافته و نتیجه در حال نهایی‌شدن است. به‌زودی دوباره سر بزنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämän nimen masternode-äänestys on päättynyt ja tulosta viimeistellään. Tarkista uudelleen pian."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapos na ang pagboto ng masternode para sa pangalang ito at tinatapos na ang resulta. Bumalik ka mamaya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le vote des masternodes pour ce nom est terminé et le résultat est en cours de finalisation. Revenez bientôt."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glasanje masternodova o ovom imenu je završilo i rezultat se finalizira. Provjerite ponovno uskoro."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ehhez a névhez tartozó masternode-szavazás lezárult, az eredmény véglegesítése folyik. Nézz vissza hamarosan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemungutan suara masternode untuk nama ini telah berakhir dan hasilnya sedang difinalisasi. Periksa kembali sebentar lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
