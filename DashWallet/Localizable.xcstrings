            "state" : "translated",
            "value" : "DEVICE SECURITY COMPROMISED\nAny 'jailbreak' app can access any other app's keychain data (and steal your Dash)."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DEVICE SECURITY COMPROMISED\nAnumang 'jailbreak' app ay maaaring maka-access ng ibang app's keychain data (at nakawin ang iyong Dash)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SÉCURITÉ DE L'APPAREIL COMPROMISE\nN'importe quelle application débridée peut accéder aux données du trousseau des autres applis (et voler vos dashs)."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DEVICE SECURITY COMPROMISED\nAny 'jailbreak' app can access any other app's keychain data (and steal your Dash)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DEVICE SECURITY COMPROMISED\nAny 'jailbreak' app can access any other app's keychain data (and steal your Dash)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KEAMANAN PERANGKAT MEMBAHAYAKAN\nAplikasi 'jailbreak' apa pun dapat mengakses data keychain aplikasi lain (dan mencuri Dash Anda)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SICUREZZA DEL DISPOSITIVO COMPROMESSA\nQualunque app \"jailbreak\" può accedere ai dati di altre app (e rubare i tuoi Dash)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端末が危険な状態です！！！\nどの脱獄アプリからでも、他のあらゆるアプリのキーチェーンのデータへアクセスが可能です（そしてあなたのDashを簡単に盗めます）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 보안이 손상되었습니다\n어떤 '탈옥' 어플이든 다른 어플의 주요 체인 데이터에 접근할 수 있습니다 (당신의 대시가 도난당할 수 있습니다)."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DEVICE SECURITY COMPROMISED\nAny 'jailbreak' app can access any other app's keychain data (and steal your Dash)."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DEVICE SECURITY COMPROMISED\nAny 'jailbreak' app can access any other app's keychain data (and steal your Dash)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DEVICE SECURITY COMPROMISED\nAny 'jailbreak' app can access any other app's keychain data (and steal your Dash)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BEVEILIGING VAN HET APPARAAT IN GEVAAR\nEen 'jailbreak'-app heeft toegang tot de sleutelhanger van andere apps (en de mogelijkheid om je dash te stelen)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BEZPIECZEŃSTWO URZĄDZENIA ZŁAMANE\nKażda aplikacja \"jailbreak\" ma dostęp do danych twoich kluczy w innych aplikacjach (i może ukraść twoje Dashe)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SEGURANÇA DO DISPOSITIVO COMPROMETIDA\nQualquer aplicativo \"jailbreak\" consegue acessar os dados de outros aplicativos (e roubar seus Dash)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SECURITATEA DISPOZITIVULUI ESTE COMPROMISĂ\nOrice aplicație \"jailbreak\" poate accesa datele keychain ale oricărei alte aplicații (și îți poate fura Dash)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "БЕЗОПАСНОСТЬ УСТРОЙСТВА ПОД УГРОЗОЙ\nЛюбое «jailbreak» приложение может получить доступ к Вашим приватным ключам (и украсть Ваши Dash)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZABEZPEČENIE ZARIADENIA KOMPROMITOVANÉ\nKaždá \"jailbreak\" aplikácia môže pristupovať k údajom o kľúčových reťazcoch každej inej aplikácie (a ukradnúť vaše Dash)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DEVICE SECURITY COMPROMISED\nAny 'jailbreak' app can access any other app's keychain data (and steal your Dash)."
          }
        },
        "sl_SI" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DEVICE SECURITY COMPROMISED\nAny 'jailbreak' app can access any other app's keychain data (and steal your Dash)."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DEVICE SECURITY COMPROMISED\nAny 'jailbreak' app can access any other app's keychain data (and steal your Dash)."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DEVICE SECURITY COMPROMISED\nAny 'jailbreak' app can access any other app's keychain data (and steal your Dash)."
