    "Owner-key withdrawals are always paid to the registered payout address." : {
      "comment" : "Evonode withdrawal",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عمليات السحب بمفتاح المالك تُدفع دائمًا إلى عنوان الدفع المسجَّل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тегленията с ключа на собственика винаги се изплащат към регистрирания адрес за изплащане."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les retirades amb clau de propietari sempre es paguen a l'adreça de pagament registrada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výběry klíčem vlastníka se vždy vyplácejí na registrovanou výplatní adresu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hævninger med ejernøgle udbetales altid til den registrerede udbetalingsadresse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auszahlungen mit dem Besitzer-Schlüssel gehen immer an die registrierte Auszahlungsadresse."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αναλήψεις με κλειδί ιδιοκτήτη πληρώνονται πάντα στην καταχωρημένη διεύθυνση πληρωμής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Owner-key withdrawals are always paid to the registered payout address."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elprenoj per la ŝlosilo de la posedanto ĉiam estas pagataj al la registrita pagadreso."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los retiros con clave de propietario siempre se pagan a la dirección de pago registrada."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omaniku võtmega tehtud väljavõtmised makstakse alati registreeritud väljamakseaadressile."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برداشت‌های با کلید مالک همیشه به نشانی پرداخت ثبت‌شده پرداخت می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omistajan avaimella tehdyt nostot maksetaan aina rekisteröityyn maksuosoitteeseen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang mga withdrawal gamit ang owner key ay palaging ibinabayad sa nakarehistrong payout address."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les retraits par clé de propriétaire sont toujours versés à l'adresse de paiement enregistrée."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povlačenja ključem vlasnika uvijek se isplaćuju na registriranu adresu za isplatu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tulajdonosi kulccsal végzett kivéteket mindig a regisztrált kifizetési címre fizetjük ki."
