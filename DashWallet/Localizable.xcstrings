    "Enter the recovery phrase to continue." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل عبارة الاسترداد للمتابعة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Въведете фразата за възстановяване, за да продължите."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introdueix la frase de recuperació per continuar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro pokračování zadejte frázi pro obnovení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtast gendannelsessætningen for at fortsætte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib die Wiederherstellungs-Wortfolge ein, um fortzufahren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εισαγάγετε τη φράση ανάκτησης για να συνεχίσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the recovery phrase to continue."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enigu la reakiran frazon por daŭrigi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce la frase de recuperación para continuar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jätkamiseks sisesta taastefraas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای ادامه عبارت بازیابی را وارد کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syötä palautuslause jatkaaksesi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilagay ang recovery phrase para magpatuloy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez la phrase de récupération pour continuer."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unesite frazu za oporavak da biste nastavili."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A folytatáshoz add meg a helyreállítási kifejezést."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan frasa pemulihan untuk melanjutkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci la frase di recupero per continuare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "続行するには復元フレーズを入力してください。"
          }
        },
        "ko" : {
