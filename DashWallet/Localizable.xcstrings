        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkendelsen blev annulleret. Din stemme blev ikke afgivet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentifizierung abgebrochen. Deine Stimme wurde nicht abgegeben."
