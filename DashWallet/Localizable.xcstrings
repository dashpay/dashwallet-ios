          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura de origen guardada: el límite inferior de escaneo elevado se aplica a partir del próximo inicio."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguskõrgus salvestatud — tõstetud skannimispiir kehtib järgmisest käivitusest."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
