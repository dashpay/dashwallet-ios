          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cheie nu a putut fi salvată în keychain. Nu s-a pierdut nimic — încearcă din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
