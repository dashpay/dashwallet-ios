    "Platform could not be reached, so owner and payout keys were not checked." : {
      "comment" : "Add masternode",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الوصول إلى Platform، لذا لم يجرِ التحقق من مفتاحَي المالك والدفع."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platform не можа да бъде достигната, затова ключовете на собственика и за изплащане не бяха проверени."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha pogut contactar amb Platform, així que no s'han comprovat les claus de propietari i de pagament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platform se nepodařilo kontaktovat, proto klíče vlastníka a výplaty nebyly zkontrolovány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platform kunne ikke nås, så ejer- og udbetalingsnøgler blev ikke tjekket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platform konnte nicht erreicht werden, daher wurden Besitzer- und Auszahlungsschlüssel nicht geprüft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η σύνδεση με το Platform, οπότε τα κλειδιά ιδιοκτήτη και πληρωμής δεν ελέγχθηκαν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platform could not be reached, so owner and payout keys were not checked."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platform ne estis atingebla, do la ŝlosiloj de posedanto kaj pago ne estis kontrolitaj."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo contactar con Platform, así que no se comprobaron las claves de propietario y de pago."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platformiga ei saadud ühendust, seega omaniku ja väljamakse võtmeid ei kontrollitud."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دسترسی به Platform ممکن نشد، بنابراین کلیدهای مالک و پرداخت بررسی نشدند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platformiin ei saatu yhteyttä, joten omistajan ja maksun avaimia ei tarkistettu."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi naabot ang Platform, kaya hindi nasuri ang owner at payout key."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platform n'a pas pu être joint : les clés de propriétaire et de paiement n'ont donc pas été vérifiées."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platform nije bio dostupan, pa ključevi vlasnika i isplate nisu provjereni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Platform nem volt elérhető, ezért a tulajdonosi és kifizetési kulcsokat nem ellenőriztük."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platform tidak dapat dihubungi, jadi kunci pemilik dan pembayaran tidak diperiksa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile raggiungere Platform, quindi le chiavi del proprietario e di pagamento non sono state verificate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platform に接続できなかったため、オーナー キーと支払キーは確認されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platform에 연결할 수 없어 소유자 키와 지급 키를 확인하지 못했습니다."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platform не беше достапен, па клучевите на сопственикот и за исплата не беа проверени."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platform tidak dapat dihubungi, jadi kunci pemilik dan pembayaran tidak disemak."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platform kunne ikke nås, så eier- og utbetalingsnøklene ble ikke sjekket."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platform was niet bereikbaar, dus eigenaars- en uitbetaalsleutels zijn niet gecontroleerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się połączyć z Platform, więc klucze właściciela i wypłaty nie zostały sprawdzone."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível acessar a Platform, então as chaves de proprietário e de pagamento não foram verificadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platform nu a putut fi contactat, deci cheile de proprietar și de plată nu au fost verificate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось связаться с Platform, поэтому ключи владельца и платёжного адреса не проверялись."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platform sa nepodarilo kontaktovať, preto kľúče vlastníka a výplaty neboli skontrolované."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platform ni bil dosegljiv, zato ključa lastnika in izplačila nista bila preverjena."
          }
        },
        "sl_SI" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platform ni bil dosegljiv, zato ključa lastnika in izplačila nista bila preverjena."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
