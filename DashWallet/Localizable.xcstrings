            "value" : "Pretvorite Dash v dobropise identitete, da boste plačevali dejanja na Platform, kot so zahteve za stik in posodobitve profila."
          }
        },
        "sl_SI" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pretvorite Dash v dobropise identitete, da boste plačevali dejanja na Platform, kot so zahteve za stik in posodobitve profila."
          }
        },
        "sq" : {
          "stringUnit" : {
