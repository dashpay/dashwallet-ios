    "Short names are decided by a network vote — use Request Username instead." : {
      "comment" : "Username marketplace",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأسماء القصيرة تُحسم بتصويت الشبكة — استخدم «طلب اسم مستخدم» بدلًا من ذلك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Късите имена се решават чрез гласуване на мрежата — използвайте вместо това „Заявка за потребителско име“."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els noms curts es decideixen amb una votació de la xarxa — fes servir «Sol·licita un nom d'usuari»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O krátkých jménech rozhoduje hlasování sítě — použijte místo toho „Požádat o uživatelské jméno“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korte navne afgøres ved en netværksafstemning — brug i stedet “Anmod om brugernavn”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über kurze Namen entscheidet eine Netzwerk-Abstimmung — verwende stattdessen „Nutzernamen anfragen“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα σύντομα ονόματα κρίνονται με ψηφοφορία του δικτύου — χρησιμοποιήστε το «Αίτημα ονόματος χρήστη»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Short names are decided by a network vote — use Request Username instead."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri mallongaj nomoj decidas reta voĉdonado — uzu anstataŭe „Peti uzantnomon“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres cortos se deciden por votación de la red — usa «Solicitar nombre de usuario» en su lugar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lühikeste nimede üle otsustab võrgu hääletus — kasuta selle asemel valikut „Taotle kasutajanime“."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نام‌های کوتاه با رأی‌گیری شبکه تعیین می‌شوند — به‌جای آن از «درخواست نام کاربری» استفاده کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyhyistä nimistä päättää verkon äänestys — käytä sen sijaan toimintoa ”Pyydä käyttäjänimeä”."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang maiikling pangalan ay pinagdedesisyunan sa pagboto ng network — gamitin ang “Humiling ng Username” sa halip."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les noms courts sont attribués par un vote du réseau — utilisez plutôt « Demander un nom d'utilisateur »."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O kratkim imenima odlučuje glasanje mreže — umjesto toga upotrijebite „Zatraži korisničko ime“."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rövid nevekről hálózati szavazás dönt — használd helyette a „Felhasználónév kérelmezése” lehetőséget."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nama pendek ditentukan lewat pemungutan suara jaringan — gunakan “Minta Nama Pengguna” sebagai gantinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nomi brevi sono decisi da una votazione della rete — usa invece «Richiedi nome utente»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短い名前はネットワーク投票で決まります。代わりに「ユーザー名を申請」をご利用ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "짧은 이름은 네트워크 투표로 결정됩니다 — 대신 ‘사용자 이름 신청’을 이용하세요."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За кратките имиња одлучува гласање на мрежата — наместо тоа користете „Побарај корисничко име“."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nama pendek ditentukan melalui pengundian rangkaian — gunakan “Mohon Nama Pengguna” sebaliknya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korte navn avgjøres ved en nettverksavstemning — bruk «Be om brukernavn» i stedet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Over korte namen beslist een netwerkstemming — gebruik in plaats daarvan ‘Gebruikersnaam aanvragen’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O krótkich nazwach decyduje głosowanie sieci — użyj zamiast tego „Złóż wniosek o nazwę”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nomes curtos são decididos por uma votação da rede — use “Solicitar nome de usuário”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numele scurte se decid printr-un vot al rețelei — folosește în schimb „Solicită un nume de utilizator”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Короткие имена определяются голосованием сети — используйте «Запросить имя пользователя»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O krátkych menách rozhoduje hlasovanie siete — použite namiesto toho „Požiadať o používateľské meno“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O kratkih imenih odloča glasovanje omrežja — namesto tega uporabite „Zahtevaj uporabniško ime“."
          }
        },
        "sl_SI" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O kratkih imenih odloča glasovanje omrežja — namesto tega uporabite „Zahtevaj uporabniško ime“."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emrat e shkurtër vendosen me një votim të rrjetit — përdor „Kërko emër përdoruesi“ në vend të kësaj."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O kratkim imenima odlučuje glasanje mreže — umesto toga koristite „Zatraži korisničko ime“."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korta namn avgörs genom en nätverksröstning — använd ”Begär användarnamn” i stället."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชื่อสั้นตัดสินด้วยการโหวตของเครือข่าย — ใช้ “ขอชื่อผู้ใช้” แทน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısa adlara ağ oylaması karar verir — bunun yerine “Kullanıcı Adı Talep Et” seçeneğini kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Короткі імена визначаються голосуванням мережі — скористайтеся «Запросити ім'я користувача»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tên ngắn do mạng bỏ phiếu quyết định — hãy dùng “Yêu cầu tên người dùng” thay thế."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短名称由网络投票决定——请改用“申请用户名”。"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短名稱由網絡投票決定——請改用「申請用戶名稱」。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短名称由网络投票决定——请改用“申请用户名”。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短名稱由網絡投票決定——請改用「申請用戶名稱」。"
          }
        }
      }
