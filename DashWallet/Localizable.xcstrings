          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začasno uporabniško ime samo po sebi ne sme zahtevati glasovanja."
          }
        },
        "sl_SI" : {
          "stringUnit" : {
            "state" : "translated",
