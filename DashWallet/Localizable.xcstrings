    "Search usernames, buy ones that are for sale, and sell or transfer your own." : {
      "comment" : "Username marketplace: screen subtitle",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابحث عن أسماء المستخدمين، واشترِ المعروض منها للبيع، وبِع أسماءك أو انقلها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Търсете потребителски имена, купувайте обявените за продажба и продавайте или прехвърляйте своите."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca noms d'usuari, compra els que estan a la venda i ven o transfereix els teus."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyhledávejte uživatelská jména, kupujte ta, která jsou na prodej, a prodávejte nebo převádějte svá vlastní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søg efter brugernavne, køb dem, der er til salg, og sælg eller overfør dine egne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
