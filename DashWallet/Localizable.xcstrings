    "No names are for sale in the recent listing activity. Show more reaches further back." : {
      "comment" : "Username marketplace: price-changes feed found no live listings yet",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد أسماء معروضة للبيع في نشاط العروض الأخير. «عرض المزيد» يعود إلى فترة أبعد."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В скорошната активност по обяви няма имена за продажба. „Покажи още“ стига по-назад във времето."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hi ha cap nom a la venda en l'activitat recent de publicacions. «Mostra'n més» arriba més enrere."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V nedávné aktivitě nabídek není žádné jméno na prodej. „Zobrazit více“ sahá dál do minulosti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen navne er til salg i den seneste opslagsaktivitet. “Vis mere” rækker længere tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der jüngsten Angebotsaktivität steht kein Name zum Verkauf. „Mehr anzeigen“ reicht weiter zurück."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κανένα όνομα δεν πωλείται στην πρόσφατη δραστηριότητα καταχωρήσεων. Το «Εμφάνιση περισσότερων» φτάνει πιο πίσω."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No names are for sale in the recent listing activity. Show more reaches further back."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neniu nomo estas vendata en la lastatempa oferta agado. „Montri pli“ atingas pli malproksimen en la pasinton."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay nombres a la venta en la actividad reciente de publicaciones. «Mostrar más» llega más atrás."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiljutises kuulutustegevuses pole ühtegi nime müügis. „Näita rohkem“ ulatub kaugemale tagasi."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در فعالیت اخیر آگهی‌ها هیچ نامی برای فروش نیست. «نمایش بیشتر» به گذشته دورتر می‌رود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viimeaikaisessa ilmoitustoiminnassa ei ole nimiä myynnissä. ”Näytä lisää” ulottuu kauemmas taaksepäin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walang pangalang ibinebenta sa mga kamakailang listing. Mas malayong nakaraan ang aabutin ng “Magpakita pa”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun nom n'est en vente dans l'activité récente des annonces. « Afficher plus » remonte plus loin."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U nedavnoj aktivnosti oglasa nema imena na prodaju. „Prikaži više“ seže dalje u prošlost."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A legutóbbi hirdetési tevékenységben nincs eladó név. A „Több megjelenítése” régebbre nyúlik vissza."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada nama yang dijual dalam aktivitas penawaran terbaru. “Tampilkan lebih banyak” menjangkau lebih jauh ke belakang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun nome è in vendita nell'attività recente degli annunci. «Mostra altro» risale più indietro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近の出品にはまだ販売中の名前がありません。「もっと見る」でさらに過去まで表示できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 등록 활동에는 판매 중인 이름이 없습니다. ‘더 보기’로 더 이전 기록까지 확인할 수 있습니다."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во неодамнешната активност на огласи нема имиња на продажба. „Прикажи повеќе“ оди подалеку наназад."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada nama untuk dijual dalam aktiviti penyenaraian terkini. “Tunjukkan lagi” menjangkau lebih jauh ke belakang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen navn er til salgs i den siste oppføringsaktiviteten. «Vis mer» går lenger tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er staan geen namen te koop in de recente aanbiedingsactiviteit. ‘Meer tonen’ gaat verder terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W ostatniej aktywności ofert żadna nazwa nie jest na sprzedaż. „Pokaż więcej” sięga dalej wstecz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum nome está à venda na atividade recente de anúncios. “Mostrar mais” alcança períodos anteriores."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niciun nume nu este de vânzare în activitatea recentă de listare. „Arată mai multe” ajunge mai departe în trecut."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В недавней активности объявлений нет имён на продажу. «Показать ещё» покажет более ранние."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V nedávnej aktivite ponúk nie je žiadne meno na predaj. „Zobraziť viac“ siaha ďalej do minulosti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V nedavni dejavnosti oglasov ni imen naprodaj. „Pokaži več“ sega dlje nazaj."
          }
        },
        "sl_SI" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V nedavni dejavnosti oglasov ni imen naprodaj. „Pokaži več“ sega dlje nazaj."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asnjë emër nuk është në shitje në aktivitetin e fundit të shpalljeve. „Shfaq më shumë“ shkon më larg në të kaluarën."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U nedavnoj aktivnosti oglasa nema imena na prodaju. „Prikaži još“ seže dalje u prošlost."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga namn är till salu i den senaste annonsaktiviteten. ”Visa mer” når längre bakåt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีชื่อประกาศขายในกิจกรรมประกาศล่าสุด “แสดงเพิ่มเติม” จะย้อนไปไกลกว่านี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son ilan hareketlerinde satılık ad yok. “Daha fazla göster” daha eskiye gider."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У нещодавній активності оголошень немає імен на продаж. «Показати більше» покаже давніші."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có tên nào đang rao bán trong hoạt động rao gần đây. “Xem thêm” sẽ lùi xa hơn."
