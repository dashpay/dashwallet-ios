    "The Dash arrives at the recipient's address after the network processes the withdrawal — this can take up to 10 minutes." : {
      "comment" : "Send confirm sheet",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصل داش إلى عنوان المستلم بعد أن تعالج الشبكة السحب — وقد يستغرق ذلك حتى 10 دقائق."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dash пристига на адреса на получателя, след като мрежата обработи тегленето — това може да отнеме до 10 минути."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els Dash arriben a l'adreça del destinatari després que la xarxa processi la retirada: això pot trigar fins a 10 minuts."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dash dorazí na adresu příjemce poté, co síť zpracuje výběr — může to trvat až 10 minut."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dash når modtagerens adresse, efter at netværket har behandlet udbetalingen — det kan tage op til 10 minutter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Dash treffen an der Adresse des Empfängers ein, nachdem das Netzwerk die Auszahlung verarbeitet hat — das kann bis zu 10 Minuten dauern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα Dash φτάνουν στη διεύθυνση του παραλήπτη αφού το δίκτυο επεξεργαστεί την ανάληψη — αυτό μπορεί να διαρκέσει έως 10 λεπτά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Dash arrives at the recipient's address after the network processes the withdrawal — this can take up to 10 minutes."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dash alvenas al la adreso de la ricevanto post kiam la reto prilaboros la elprenon — tio povas daŭri ĝis 10 minutoj."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Dash llegan a la dirección del destinatario después de que la red procese la retirada; esto puede tardar hasta 10 minutos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dash jõuab saaja aadressile pärast seda, kui võrk on väljamakse töödelnud — see võib võtta kuni 10 minutit."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پس از آنکه شبکه برداشت را پردازش کند دش به نشانی گیرنده می‌رسد — این کار می‌تواند تا ۱۰ دقیقه طول بکشد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dash saapuu vastaanottajan osoitteeseen sen jälkeen, kun verkko on käsitellyt noston — tämä voi kestää jopa 10 minuuttia."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dumarating ang Dash sa address ng tatanggap matapos iproseso ng network ang withdrawal — maaari itong tumagal nang hanggang 10 minuto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Dash arrivent à l'adresse du destinataire une fois que le réseau a traité le retrait — cela peut prendre jusqu'à 10 minutes."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dash stiže na adresu primatelja nakon što mreža obradi isplatu — to može potrajati do 10 minuta."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Dash azután érkezik meg a címzett címére, hogy a hálózat feldolgozta a kifizetést — ez akár 10 percig is tarthat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dash tiba di alamat penerima setelah jaringan memproses penarikan — ini bisa memakan waktu hingga 10 menit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Dash arrivano all'indirizzo del destinatario dopo che la rete ha elaborato il prelievo: può richiedere fino a 10 minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワークが出金を処理した後、Dash が受取人のアドレスに届きます。最大 10 分ほどかかる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네트워크가 출금을 처리한 뒤 Dash가 수신자의 주소에 도착합니다. 최대 10분이 걸릴 수 있습니다."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dash стигнува на адресата на примачот откако мрежата ќе го обработи повлекувањето — тоа може да потрае до 10 минути."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dash tiba di alamat penerima selepas rangkaian memproses pengeluaran — ini boleh mengambil masa sehingga 10 minit."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dash når mottakerens adresse etter at nettverket har behandlet uttaket — det kan ta opptil 10 minutter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Dash komt aan op het adres van de ontvanger nadat het netwerk de opname heeft verwerkt — dit kan tot 10 minuten duren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dash trafią na adres odbiorcy po przetworzeniu wypłaty przez sieć — może to potrwać do 10 minut."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os Dash chegam ao endereço do destinatário depois que a rede processar o saque — isso pode levar até 10 minutos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dash ajunge la adresa destinatarului după ce rețeaua procesează retragerea — asta poate dura până la 10 minute."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dash поступят на адрес получателя после того, как сеть обработает вывод — это может занять до 10 минут."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dash dorazí na adresu príjemcu po tom, ako sieť spracuje výber — môže to trvať až 10 minút."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dash prispe na naslov prejemnika, ko omrežje obdela izplačilo — to lahko traja do 10 minut."
          }
        },
        "sl_SI" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dash prispe na naslov prejemnika, ko omrežje obdela izplačilo — to lahko traja do 10 minut."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dash mbërrin te adresa e marrësit pasi rrjeti të përpunojë tërheqjen — kjo mund të zgjasë deri në 10 minuta."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dash stiže na adresu primaoca nakon što mreža obradi isplatu — to može potrajati do 10 minuta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dash når mottagarens adress efter att nätverket har behandlat uttaget — det kan ta upp till 10 minuter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dash จะไปถึงที่อยู่ของผู้รับหลังจากเครือข่ายประมวลผลการถอนแล้ว — อาจใช้เวลาถึง 10 นาที"
          }
