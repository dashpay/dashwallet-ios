    "Signing with the owner key — the withdrawal goes to the registered payout address." : {
      "comment" : "Tracked masternodes",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التوقيع بمفتاح المالك — يذهب السحب إلى عنوان الدفع المسجَّل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подписване с ключа на собственика — тегленето отива към регистрирания адрес за изплащане."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signant amb la clau de propietari — la retirada va a l'adreça de pagament registrada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podepisujeme klíčem vlastníka — výběr míří na registrovanou výplatní adresu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signerer med ejernøglen — hævningen går til den registrerede udbetalingsadresse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signieren mit dem Besitzer-Schlüssel — die Auszahlung geht an die registrierte Auszahlungsadresse."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υπογραφή με το κλειδί ιδιοκτήτη — η ανάληψη πηγαίνει στην καταχωρημένη διεύθυνση πληρωμής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signing with the owner key — the withdrawal goes to the registered payout address."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subskribante per la ŝlosilo de la posedanto — la elpreno iras al la registrita pagadreso."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firmando con la clave de propietario — el retiro va a la dirección de pago registrada."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allkirjastame omaniku võtmega — väljavõtmine läheb registreeritud väljamakseaadressile."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امضا با کلید مالک — برداشت به نشانی پرداخت ثبت‌شده می‌رود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allekirjoitetaan omistajan avaimella — nosto menee rekisteröityyn maksuosoitteeseen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
