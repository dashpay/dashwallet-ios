          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конвертируйте Dash в кредиты идентификатора, чтобы оплачивать действия в Platform: запросы на добавление в контакты и обновления профиля."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preveďte Dash na kredity identity, aby ste mohli platiť akcie na Platform, ako sú žiadosti o kontakt a aktualizácie profilu."
          }
        },
        "sl" : {
          "stringUnit" : {
