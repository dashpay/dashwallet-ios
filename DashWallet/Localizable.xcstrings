        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มาสเตอร์โหนดบางตัวของคุณอาจไม่อยู่ในรายการนี้ — กระเป๋าเงินอ่านชุดคีย์โหวตของคุณไม่ครบ ซิงค์ให้เสร็จแล้วเปิดหน้านี้ใหม่"
