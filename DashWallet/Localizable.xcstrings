          "stringUnit" : {
            "state" : "translated",
            "value" : "Απορρίφθηκαν %lld ανεπιβεβαίωτες συναλλαγές, αλλά η επανασάρωση φίλτρων δεν ξεκίνησε — εκτελέστε το «Επανασάρωση φίλτρων» παραπάνω."
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Dropped %lld unconfirmed transaction, but the filter rescan couldn't start — run Rescan Filters above."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Dropped %lld unconfirmed transactions, but the filter rescan couldn't start — run Rescan Filters above."
                }
