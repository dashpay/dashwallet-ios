    "Anyone will be able to buy the name for this exact price. The proceeds arrive as credits on your identity balance." : {
      "comment" : "Username marketplace: set price sheet body",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتمكن أي شخص من شراء الاسم بهذا السعر تحديدًا. تصل العائدات كأرصدة إلى رصيد هويتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всеки ще може да купи името точно на тази цена. Приходите постъпват като кредити в баланса на вашата самоличност."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualsevol podrà comprar el nom exactament a aquest preu. Els ingressos arriben com a crèdits al saldo de la teva identitat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdokoli bude moci jméno koupit přesně za tuto cenu. Výnos přijde jako kredity na zůstatek vaší identity."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle vil kunne købe navnet til præcis denne pris. Provenuet kommer ind som kreditter på din identitetssaldo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder wird den Namen zu genau diesem Preis kaufen können. Der Erlös wird als Credits deinem Identitäts-Guthaben gutgeschrieben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οποιοσδήποτε θα μπορεί να αγοράσει το όνομα ακριβώς σε αυτή την τιμή. Τα έσοδα φτάνουν ως credits στο υπόλοιπο της ταυτότητάς σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone will be able to buy the name for this exact price. The proceeds arrive as credits on your identity balance."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iu ajn povos aĉeti la nomon precize je ĉi tiu prezo. La enspezo alvenas kiel kreditoj sur via identeca saldo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera podrá comprar el nombre exactamente por este precio. Los ingresos llegan como créditos a tu saldo de identidad."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
