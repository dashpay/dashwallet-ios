        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nama pengguna sementara itu sendiri tidak boleh memerlukan pemungutan suara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nome utente temporaneo non deve a sua volta richiedere una votazione."
          }
