    "DashPay replaces long cryptic addresses with usernames. Add friends as contacts, send money to a name, and keep every payment organized by person." : {
      "comment" : "DashPay intro: pitch paragraph",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستبدل DashPay العناوين الطويلة الغامضة بأسماء المستخدمين. أضف الأصدقاء كجهات اتصال، وأرسل المال إلى اسم، واحتفظ بكل دفعة منظمة حسب الشخص."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay заменя дългите неразбираеми адреси с потребителски имена. Добавяйте приятели като контакти, изпращайте пари на име и пазете всяко плащане подредено по човек."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay substitueix les adreces llargues i críptiques per noms d'usuari. Afegeix amics com a contactes, envia diners a un nom i mantén cada pagament organitzat per persona."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay nahrazuje dlouhé nesrozumitelné adresy uživatelskými jmény. Přidejte si přátele jako kontakty, posílejte peníze na jméno a mějte každou platbu uspořádanou podle osoby."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay erstatter lange kryptiske adresser med brugernavne. Tilføj venner som kontakter, send penge til et navn, og hold hver betaling ordnet efter person."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay ersetzt lange kryptische Adressen durch Benutzernamen. Füge Freunde als Kontakte hinzu, sende Geld an einen Namen und halte jede Zahlung nach Person geordnet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το DashPay αντικαθιστά τις μακροσκελείς κρυπτικές διευθύνσεις με ονόματα χρήστη. Προσθέστε φίλους ως επαφές, στείλτε χρήματα σε ένα όνομα και κρατήστε κάθε πληρωμή οργανωμένη ανά άτομο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay replaces long cryptic addresses with usernames. Add friends as contacts, send money to a name, and keep every payment organized by person."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay anstataŭigas longajn kriptajn adresojn per uzantnomoj. Aldonu amikojn kiel kontaktojn, sendu monon al nomo kaj tenu ĉiun pagon ordigita laŭ persono."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay sustituye las largas direcciones crípticas por nombres de usuario. Añade amigos como contactos, envía dinero a un nombre y mantén cada pago organizado por persona."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay asendab pikad ja arusaamatud aadressid kasutajanimedega. Lisa sõbrad kontaktideks, saada raha nimele ja hoia iga makse inimeste kaupa korras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏DashPay نشانی‌های بلند و نامفهوم را با نام کاربری جایگزین می‌کند. دوستان را به‌عنوان مخاطب بیفزایید، به یک نام پول بفرستید و هر پرداخت را بر اساس شخص مرتب نگه دارید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay korvaa pitkät ja käsittämättömät osoitteet käyttäjätunnuksilla. Lisää ystäviä yhteystiedoiksi, lähetä rahaa nimelle ja pidä jokainen maksu järjestyksessä henkilöittäin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinapalitan ng DashPay ang mahahaba't magulong address ng username. Idagdag ang mga kaibigan bilang kontak, magpadala ng pera sa isang pangalan, at panatilihing nakaayos ayon sa tao ang bawat bayad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay remplace les longues adresses cryptiques par des noms d'utilisateur. Ajoutez vos amis comme contacts, envoyez de l'argent à un nom et gardez chaque paiement organisé par personne."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay zamjenjuje duge i nerazumljive adrese korisničkim imenima. Dodajte prijatelje kao kontakte, pošaljite novac na ime i držite svako plaćanje uredno posloženo po osobi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A DashPay a hosszú, rejtélyes címeket felhasználónevekre cseréli. Add hozzá barátaidat névjegyként, küldj pénzt egy névre, és tartsd minden fizetésedet személyenként rendezve."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay mengganti alamat panjang yang membingungkan dengan nama pengguna. Tambahkan teman sebagai kontak, kirim uang ke sebuah nama, dan simpan setiap pembayaran secara rapi per orang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay sostituisce i lunghi indirizzi criptici con i nomi utente. Aggiungi amici come contatti, invia denaro a un nome e mantieni ogni pagamento organizzato per persona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay は長くて分かりにくいアドレスをユーザー名に置き換えます。友人を連絡先に追加し、名前宛てに送金して、すべての支払いを相手ごとに整理できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay는 길고 알아보기 어려운 주소를 사용자 이름으로 대체합니다. 친구를 연락처로 추가하고 이름으로 송금하며 모든 결제를 사람별로 정리하세요."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay ги заменува долгите и нејасни адреси со кориснички имиња. Додајте пријатели како контакти, испраќајте пари на име и држете го секое плаќање уредено по лице."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay menggantikan alamat panjang yang sukar difahami dengan nama pengguna. Tambah rakan sebagai kenalan, hantar wang kepada satu nama dan kekalkan setiap pembayaran tersusun mengikut orang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay erstatter lange, kryptiske adresser med brukernavn. Legg til venner som kontakter, send penger til et navn, og hold hver betaling ordnet per person."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay vervangt lange cryptische adressen door gebruikersnamen. Voeg vrienden toe als contact, stuur geld naar een naam en houd elke betaling per persoon georganiseerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay zastępuje długie, niezrozumiałe adresy nazwami użytkowników. Dodawaj znajomych do kontaktów, wysyłaj pieniądze na nazwę i miej każdą płatność uporządkowaną według osoby."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O DashPay substitui endereços longos e crípticos por nomes de usuário. Adicione amigos como contatos, envie dinheiro para um nome e mantenha cada pagamento organizado por pessoa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay înlocuiește adresele lungi și criptice cu nume de utilizator. Adaugă-ți prietenii la contacte, trimite bani către un nume și ține fiecare plată organizată pe persoane."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay заменяет длинные непонятные адреса именами пользователей. Добавляйте друзей в контакты, отправляйте деньги на имя и держите все платежи упорядоченными по людям."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay nahrádza dlhé nezrozumiteľné adresy používateľskými menami. Pridajte si priateľov ako kontakty, posielajte peniaze na meno a majte každú platbu usporiadanú podľa osoby."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay dolge in nerazumljive naslove nadomesti z uporabniškimi imeni. Prijatelje dodajte med stike, denar pošljite na ime in vsako plačilo ohranite urejeno po osebah."
          }
        },
        "sl_SI" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay dolge in nerazumljive naslove nadomesti z uporabniškimi imeni. Prijatelje dodajte med stike, denar pošljite na ime in vsako plačilo ohranite urejeno po osebah."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay i zëvendëson adresat e gjata e të pakuptueshme me emra përdoruesish. Shtoni miqtë si kontakte, dërgoni para te një emër dhe mbajeni çdo pagesë të organizuar sipas personit."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay zamenjuje duge i nerazumljive adrese korisničkim imenima. Dodajte prijatelje kao kontakte, pošaljite novac na ime i držite svako plaćanje uredno po osobi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay ersätter långa kryptiska adresser med användarnamn. Lägg till vänner som kontakter, skicka pengar till ett namn och håll varje betalning ordnad per person."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay แทนที่ที่อยู่ยาว ๆ ที่อ่านไม่รู้เรื่องด้วยชื่อผู้ใช้ เพิ่มเพื่อนเป็นผู้ติดต่อ ส่งเงินไปยังชื่อ และจัดระเบียบทุกการชำระเงินตามรายบุคคล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay, uzun ve anlaşılmaz adreslerin yerine kullanıcı adlarını koyar. Arkadaşlarınızı kişi olarak ekleyin, bir ada para gönderin ve her ödemeyi kişiye göre düzenli tutun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay замінює довгі незрозумілі адреси іменами користувачів. Додавайте друзів до контактів, надсилайте гроші на ім'я й тримайте кожен платіж упорядкованим за людьми."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay thay các địa chỉ dài khó hiểu bằng tên người dùng. Thêm bạn bè làm liên hệ, gửi tiền tới một cái tên và giữ mọi khoản thanh toán được sắp xếp theo từng người."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay 用用户名取代冗长难懂的地址。将好友添加为联系人，向一个名称汇款，并按人整理每一笔支付。"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay 用用戶名稱取代冗長難懂的位址。將好友加入聯絡人，向一個名稱匯款，並按人整理每一筆支付。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay 用用户名取代冗长难懂的地址。将好友添加为联系人，向一个名称汇款，并按人整理每一笔支付。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DashPay 用用戶名稱取代冗長難懂的位址。將好友加入聯絡人，向一個名稱匯款，並按人整理每一筆支付。"
          }
        }
      }
    },
