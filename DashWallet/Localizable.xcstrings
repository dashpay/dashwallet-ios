    "Convert Dash into identity credits to pay for Platform actions like contact requests and profile updates." : {
      "comment" : "Identity top-up sheet — body",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حوّل Dash إلى أرصدة هوية لدفع تكاليف إجراءات Platform مثل طلبات جهات الاتصال وتحديثات الملف الشخصي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Превърнете Dash в кредити за самоличност, за да плащате действия в Platform като заявки за контакт и обновяване на профила."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converteix Dash en crèdits d'identitat per pagar accions de Platform com les sol·licituds de contacte i les actualitzacions de perfil."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Převeďte Dash na kredity identity, abyste mohli platit akce na Platform, jako jsou žádosti o kontakt a aktualizace profilu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konvertér Dash til identitetskreditter for at betale for Platform-handlinger som kontaktanmodninger og profilopdateringer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wandle Dash in Identitäts-Credits um, um Platform-Aktionen wie Kontaktanfragen und Profilaktualisierungen zu bezahlen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετατρέψτε Dash σε credits ταυτότητας για να πληρώνετε ενέργειες στο Platform, όπως αιτήματα επαφής και ενημερώσεις προφίλ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convert Dash into identity credits to pay for Platform actions like contact requests and profile updates."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konvertu Dash al identecaj kreditoj por pagi Platform-agojn kiel kontaktpetojn kaj profilajn ĝisdatigojn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convierte Dash en créditos de identidad para pagar acciones de Platform como solicitudes de contacto y actualizaciones de perfil."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaheta Dash identiteedikrediidiks, et maksta Platformi toimingute eest, näiteks kontaktipäringute ja profiiliuuenduste eest."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏Dash را به اعتبار هویت تبدیل کنید تا هزینه اقدام‌های Platform مانند درخواست‌های مخاطب و به‌روزرسانی نمایه را بپردازید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muunna Dash identiteettikrediiteiksi, joilla maksat Platform-toimintoja, kuten yhteyspyyntöjä ja profiilipäivityksiä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palitan ang Dash ng mga identity credit para bayaran ang mga aksyon sa Platform tulad ng contact request at pag-update ng profile."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convertissez des Dash en crédits d'identité pour payer les actions Platform telles que les demandes de contact et les mises à jour de profil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pretvorite Dash u kredite identiteta kako biste plaćali radnje na Platform, poput zahtjeva za kontakt i izmjena profila."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váltsd át a Dasht identitáskreditre, hogy fizetni tudj a Platform műveletekért, például a névjegykérésekért és a profilfrissítésekért."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubah Dash menjadi kredit identitas untuk membayar tindakan Platform seperti permintaan kontak dan pembaruan profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converti Dash in crediti identità per pagare le azioni su Platform come richieste di contatto e aggiornamenti del profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dash をアイデンティティ クレジットに変換して、連絡先リクエストやプロフィール更新などの Platform 上の操作を支払います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연락처 요청, 프로필 업데이트 같은 Platform 작업 비용을 내려면 Dash를 아이덴티티 크레딧으로 전환하세요."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Претворете Dash во кредити за идентитет за да плаќате дејства на Platform, како барања за контакт и ажурирања на профилот."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tukarkan Dash kepada kredit identiti untuk membayar tindakan Platform seperti permintaan kenalan dan kemas kini profil."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veksle Dash til identitetskreditter for å betale for Platform-handlinger som kontaktforespørsler og profiloppdateringer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet Dash om in identiteitskrediet om Platform-acties te betalen, zoals contactverzoeken en profielupdates."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamień Dash na kredyty tożsamości, aby opłacać działania na Platform, takie jak zaproszenia do kontaktów i aktualizacje profilu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converta Dash em créditos de identidade para pagar ações da Platform, como solicitações de contato e atualizações de perfil."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
