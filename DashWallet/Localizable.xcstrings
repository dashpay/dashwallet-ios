        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر کسی می‌تواند این نام را دقیقاً به همین قیمت بخرد. درآمد آن به‌صورت اعتبار به موجودی هویت شما می‌رسد."
          }
        },
        "fi" : {
          "stringUnit" : {
