        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağ çekimi işledikten sonra Dash alıcının adresine ulaşır — bu 10 dakikaya kadar sürebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
