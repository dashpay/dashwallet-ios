    "Your Dash Platform identity appears here once you register a username." : {
      "comment" : "Identities",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر هوية Dash Platform الخاصة بك هنا بمجرد تسجيلك اسم مستخدم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вашата самоличност в Dash Platform ще се появи тук, след като регистрирате потребителско име."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La teva identitat de Dash Platform apareixerà aquí quan registris un nom d'usuari."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše identita Dash Platform se zde zobrazí, jakmile si zaregistrujete uživatelské jméno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Dash Platform-identitet vises her, når du registrerer et brugernavn."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Dash-Platform-Identität erscheint hier, sobald du einen Benutzernamen registrierst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ταυτότητά σας στο Dash Platform εμφανίζεται εδώ μόλις καταχωρίσετε ένα όνομα χρήστη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Dash Platform identity appears here once you register a username."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Via Dash Platform-identeco aperos ĉi tie kiam vi registros uzantnomon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu identidad de Dash Platform aparecerá aquí cuando registres un nombre de usuario."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su Dash Platformi identiteet ilmub siia, kui registreerid kasutajanime."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هویت Dash Platform شما به‌محض ثبت نام کاربری اینجا نمایان می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dash Platform -identiteettisi näkyy tässä, kun rekisteröit käyttäjätunnuksen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lilitaw dito ang iyong Dash Platform na pagkakakilanlan kapag nagparehistro ka ng username."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre identité Dash Platform apparaîtra ici une fois que vous aurez enregistré un nom d'utilisateur."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš Dash Platform identitet pojavit će se ovdje kada registrirate korisničko ime."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Dash Platform-identitásod itt jelenik meg, amint regisztrálsz egy felhasználónevet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identitas Dash Platform Anda muncul di sini setelah Anda mendaftarkan nama pengguna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua identità Dash Platform comparirà qui una volta registrato un nome utente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザー名を登録すると、Dash Platform のアイデンティティがここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 이름을 등록하면 Dash Platform 아이덴티티가 여기에 표시됩니다."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вашиот Dash Platform идентитет ќе се појави овде откако ќе регистрирате корисничко име."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identiti Dash Platform anda muncul di sini setelah anda mendaftarkan nama pengguna."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dash Platform-identiteten din vises her når du registrerer et brukernavn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je Dash Platform-identiteit verschijnt hier zodra je een gebruikersnaam registreert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja tożsamość Dash Platform pojawi się tutaj, gdy zarejestrujesz nazwę użytkownika."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua identidade da Dash Platform aparecerá aqui assim que você registrar um nome de usuário."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identitatea ta Dash Platform apare aici după ce înregistrezi un nume de utilizator."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш идентификатор Dash Platform появится здесь, как только вы зарегистрируете имя пользователя."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša identita Dash Platform sa tu zobrazí, keď si zaregistrujete používateľské meno."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša identiteta Dash Platform se bo prikazala tukaj, ko registrirate uporabniško ime."
          }
        },
        "sl_SI" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša identiteta Dash Platform se bo prikazala tukaj, ko registrirate uporabniško ime."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identiteti juaj Dash Platform shfaqet këtu sapo të regjistroni një emër përdoruesi."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš Dash Platform identitet pojaviće se ovde kada registrujete korisničko ime."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Dash Platform-identitet visas här när du registrerar ett användarnamn."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวตน Dash Platform ของคุณจะปรากฏที่นี่เมื่อคุณลงทะเบียนชื่อผู้ใช้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kullanıcı adı kaydettiğinizde Dash Platform kimliğiniz burada görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш ідентифікатор Dash Platform з'явиться тут, щойно ви зареєструєте ім'я користувача."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danh tính Dash Platform của bạn sẽ xuất hiện ở đây khi bạn đăng ký một tên người dùng."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注册用户名后，您的 Dash Platform 身份会显示在这里。"
