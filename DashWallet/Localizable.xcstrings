          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kan DashPay blijven gebruiken voor betalingen, maar je kunt je profiel niet bijwerken of meer contacten toevoegen totdat je je krediet saldo opwaardeert"
          }
        },
        "pl" : {
