        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due to regulatory constraints, we need to verify that you are not in the UK.  We only check your location when you enter the Coinbase features."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debido a restricciones de regulación, debemos validar que no está en el Reino Unido. Solo validaremos su ubicación cuando ingrese a las funcionalidades de Coinbase."
