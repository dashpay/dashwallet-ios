          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Основната самоличност може да бъде избрана само от активния портфейл"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La identitat principal només es pot triar des de la cartera activa"
