    "Anyone that has your recovery phrase can access your funds." : {
      "comment" : "Recovery phrase backup: security warning body — anyone with the phrase can spend the funds",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أي شخص يملك عبارة الاسترداد الخاصة بك يمكنه الوصول إلى أموالك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всеки, който има вашата фраза за възстановяване, може да получи достъп до средствата ви."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualsevol que tingui la teva frase de recuperació pot accedir als teus fons."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdokoli, kdo má vaši frázi pro obnovení, může získat přístup k vašim prostředkům."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enhver, der har din gendannelsessætning, kan få adgang til dine midler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer deine Wiederherstellungs-Wortfolge hat, kann auf dein Guthaben zugreifen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όποιος έχει τη φράση ανάκτησής σας μπορεί να αποκτήσει πρόσβαση στα κεφάλαιά σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone that has your recovery phrase can access your funds."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iu ajn, kiu havas vian reakiran frazon, povas aliri viajn monrimedojn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera que tenga tu frase de recuperación puede acceder a tus fondos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igaüks, kellel on sinu taastefraas, pääseb ligi sinu vahenditele."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر کسی که عبارت بازیابی شما را داشته باشد می‌تواند به دارایی شما دسترسی پیدا کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuka tahansa, jolla on palautuslauseesi, pääsee käsiksi varoihisi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinumang may hawak ng iyong recovery phrase ay maaaring ma-access ang iyong pondo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiconque possède votre phrase de récupération peut accéder à vos fonds."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svatko tko ima vašu frazu za oporavak može pristupiti vašim sredstvima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bárki, akinek megvan a helyreállítási kifejezésed, hozzáférhet a pénzedhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
