    "Authentication cancelled. Your vote was not cast." : {
      "comment" : "Voting",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُلغي التحقق. لم يُدلَ بصوتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удостоверяването е отменено. Гласът ви не беше подаден."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autenticació cancel·lada. El teu vot no s'ha emès."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ověření zrušeno. Váš hlas nebyl odevzdán."
