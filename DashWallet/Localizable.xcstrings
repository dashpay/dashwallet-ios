    "In a network vote — you can join as a contender" : {
      "comment" : "Username marketplace: search row for a contested label with an active vote by others",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في تصويت الشبكة — يمكنك الانضمام كمتنافس"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В гласуване на мрежата — можете да се включите като кандидат"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En una votació de la xarxa — t'hi pots afegir com a aspirant"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V hlasování sítě — můžete se připojit jako uchazeč"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I en netværksafstemning — du kan deltage som udfordrer"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In einer Netzwerk-Abstimmung — du kannst als Bewerber beitreten"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε ψηφοφορία δικτύου — μπορείτε να συμμετάσχετε ως διεκδικητής"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a network vote — you can join as a contender"
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En reta voĉdonado — vi povas aliĝi kiel konkuranto"
          }
        },
        "es" : {
