    "You can continue to use DashPay for payments but you cannot update your profile or add more contacts until you top up your credit balance" : {
      "comment" : "Credits",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can continue to use DashPay for payments but you cannot update your profile or add more contacts until you top up your credit balance"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can continue to use DashPay for payments but you cannot update your profile or add more contacts until you top up your credit balance"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can continue to use DashPay for payments but you cannot update your profile or add more contacts until you top up your credit balance"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can continue to use DashPay for payments but you cannot update your profile or add more contacts until you top up your credit balance"
          }
