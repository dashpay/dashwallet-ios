    "Keys are stored in this device's keychain and never leave it except to sign the action you request." : {
      "comment" : "Tracked masternodes",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُخزَّن المفاتيح في سلسلة مفاتيح هذا الجهاز ولا تغادرها أبدًا إلا لتوقيع الإجراء الذي تطلبه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключовете се съхраняват в keychain на това устройство и никога не го напускат, освен за да подпишат действието, което поискате."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les claus es desen al clauer d'aquest dispositiu i mai no en surten, tret de per signar l'acció que demanis."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klíče jsou uloženy v keychainu tohoto zařízení a nikdy jej neopouštějí, kromě podepsání akce, o kterou požádáte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nøglerne opbevares i denne enheds keychain og forlader den aldrig, undtagen for at signere den handling, du beder om."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlüssel werden in der Keychain dieses Geräts gespeichert und verlassen sie nur, um die von dir angeforderte Aktion zu signieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα κλειδιά αποθηκεύονται στο keychain αυτής της συσκευής και δεν το εγκαταλείπουν ποτέ, παρά μόνο για να υπογράψουν την ενέργεια που ζητάτε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keys are stored in this device's keychain and never leave it except to sign the action you request."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ŝlosiloj estas konservataj en la ŝlosilaro de ĉi tiu aparato kaj neniam forlasas ĝin, krom por subskribi la agon, kiun vi petas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves se guardan en el llavero de este dispositivo y nunca salen de él salvo para firmar la acción que solicites."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Võtmeid hoitakse selle seadme võtmehoidjas ja need ei lahku sealt kunagi, välja arvatud sinu soovitud toimingu allkirjastamiseks."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کلیدها در کی‌چین این دستگاه ذخیره می‌شوند و جز برای امضای کاری که درخواست می‌کنید هرگز از آن خارج نمی‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaimet säilytetään tämän laitteen avainnipussa eivätkä ne poistu siitä muutoin kuin pyytämäsi toiminnon allekirjoittamiseksi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakaimbak ang mga key sa keychain ng device na ito at hindi kailanman umaalis dito maliban para lagdaan ang aksyong hinihiling mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés sont stockées dans le trousseau de cet appareil et n'en sortent jamais, sauf pour signer l'action que vous demandez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ključevi se čuvaju u keychainu ovog uređaja i nikada ga ne napuštaju, osim da potpišu radnju koju zatražite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kulcsok ennek az eszköznek a kulcstartójában vannak, és soha nem hagyják el, kivéve az általad kért művelet aláírásához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci disimpan di keychain perangkat ini dan tidak pernah keluar darinya kecuali untuk menandatangani tindakan yang Anda minta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chiavi sono conservate nel portachiavi di questo dispositivo e non lo lasciano mai, se non per firmare l'azione che richiedi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーはこの端末のキーチェーンに保存され、あなたが要求した操作に署名する場合を除き、外部に出ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키는 이 기기의 키체인에 저장되며, 회원님이 요청한 작업에 서명할 때를 제외하고는 기기를 벗어나지 않습니다."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клучевите се чуваат во keychain на овој уред и никогаш не го напуштаат, освен за да го потпишат дејството што го барате."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci disimpan dalam keychain peranti ini dan tidak pernah keluar daripadanya kecuali untuk menandatangani tindakan yang anda minta."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nøklene lagres i denne enhetens nøkkelring og forlater den aldri, bortsett fra for å signere handlingen du ber om."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleutels worden bewaard in de sleutelhanger van dit apparaat en verlaten die alleen om de actie te ondertekenen die je vraagt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucze są przechowywane w pęku kluczy tego urządzenia i nigdy go nie opuszczają, poza podpisaniem żądanej przez Ciebie akcji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
