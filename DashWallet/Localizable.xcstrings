          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключи хранятся в связке ключей этого устройства и никогда её не покидают, кроме как для подписи запрошенного вами действия."
          }
        },
        "sk" : {
          "stringUnit" : {
