    "Keep these coins private. Network and privacy fees apply." : {
      "comment" : "CoinJoin",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ هذه العملات خاصة. تُطبَّق رسوم الشبكة ورسوم الخصوصية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запазете тези монети поверителни. Прилагат се мрежови такси и такси за поверителност."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén aquestes monedes privades. S'apliquen comissions de xarxa i de privadesa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponechat tyto mince soukromé. Účtují se síťové poplatky a poplatky za soukromí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold disse mønter private. Der gælder netværks- og privatlivsgebyrer."
          }
        },
        "de" : {
