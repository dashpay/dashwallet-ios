          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang pansamantalang username mismo ay hindi dapat mangailangan ng pagboto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom d'utilisateur temporaire ne doit pas lui-même nécessiter un vote."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privremeno korisničko ime ne smije ni samo zahtijevati glasanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ideiglenes felhasználónév maga nem igényelhet szavazást."
