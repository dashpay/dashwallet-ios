    "You're all set. Other users can now send you contact requests — and you can send yours." : {
      "comment" : "DashPay: body of the enable success sheet",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل شيء جاهز. يمكن للمستخدمين الآخرين الآن إرسال طلبات جهات اتصال إليك — ويمكنك إرسال طلباتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всичко е готово. Други потребители вече могат да ви изпращат заявки за контакт — а вие можете да изпращате своите."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tot a punt. Ara altres usuaris et poden enviar sol·licituds de contacte, i tu pots enviar les teves."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vše je připraveno. Ostatní uživatelé vám nyní mohou posílat žádosti o kontakt — a vy můžete posílat ty své."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt er klar. Andre brugere kan nu sende dig kontaktanmodninger — og du kan sende dine."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles bereit. Andere Nutzer können dir jetzt Kontaktanfragen senden — und du kannst deine senden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα έτοιμα. Άλλοι χρήστες μπορούν τώρα να σας στέλνουν αιτήματα επαφής — και εσείς μπορείτε να στέλνετε τα δικά σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're all set. Other users can now send you contact requests — and you can send yours."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ĉio pretas. Aliaj uzantoj nun povas sendi al vi kontaktpetojn — kaj vi povas sendi la viajn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo listo. Otros usuarios ya pueden enviarte solicitudes de contacto, y tú puedes enviar las tuyas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kõik on valmis. Teised kasutajad saavad nüüd sulle kontaktitaotlusi saata — ja sina saad saata enda omi."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همه چیز آماده است. کاربران دیگر حالا می‌توانند برایتان درخواست تماس بفرستند — و شما هم می‌توانید درخواست‌های خود را بفرستید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki valmista. Muut käyttäjät voivat nyt lähettää sinulle yhteyspyyntöjä — ja sinä voit lähettää omasi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handa na ang lahat. Makakapagpadala na ngayon sa iyo ng kahilingan sa pakikipag-ugnay ang ibang user — at makakapagpadala ka na rin ng sa iyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout est prêt. D'autres utilisateurs peuvent désormais vous envoyer des demandes de contact — et vous pouvez envoyer les vôtres."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sve je spremno. Drugi korisnici sada vam mogu slati zahtjeve za kontakt — a i vi možete slati svoje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden készen áll. Más felhasználók mostantól kapcsolatkérést küldhetnek neked — és te is elküldheted a sajátodat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua siap. Pengguna lain kini dapat mengirimi Anda permintaan kontak — dan Anda dapat mengirim milik Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È tutto pronto. Ora altri utenti possono inviarti richieste di contatto, e tu puoi inviare le tue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "準備が整いました。他のユーザーがあなたに連絡先リクエストを送れるようになり、あなたも自分のリクエストを送れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모두 준비되었습니다. 이제 다른 사용자가 회원님에게 연락처 요청을 보낼 수 있고, 회원님도 요청을 보낼 수 있습니다."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сè е спремно. Другите корисници сега можат да ви испраќаат барања за контакт — а вие можете да ги испраќате вашите."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semuanya sedia. Pengguna lain kini boleh menghantar permintaan kenalan kepada anda — dan anda boleh menghantar permintaan anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt er klart. Andre brukere kan nå sende deg kontaktforespørsler — og du kan sende dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles staat klaar. Andere gebruikers kunnen je nu contactverzoeken sturen — en jij kunt de jouwe versturen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko gotowe. Inni użytkownicy mogą teraz wysyłać Ci zaproszenia do kontaktów — a Ty możesz wysyłać swoje."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo pronto. Outros usuários já podem lhe enviar solicitações de contato — e você pode enviar as suas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totul este gata. Alți utilizatori îți pot trimite acum cereri de contact — iar tu le poți trimite pe ale tale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё готово. Другие пользователи теперь могут отправлять вам запросы на добавление в контакты — и вы можете отправлять свои."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všetko je pripravené. Ostatní používatelia vám teraz môžu posielať žiadosti o kontakt — a vy môžete posielať tie svoje."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vse je pripravljeno. Drugi uporabniki vam zdaj lahko pošiljajo zahteve za stik — in vi lahko pošiljate svoje."
          }
        },
        "sl_SI" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vse je pripravljeno. Drugi uporabniki vam zdaj lahko pošiljajo zahteve za stik — in vi lahko pošiljate svoje."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjithçka është gati. Përdoruesit e tjerë tani mund t'ju dërgojnë kërkesa për kontakt — dhe ju mund të dërgoni tuajat."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sve je spremno. Drugi korisnici sada mogu da vam šalju zahteve za kontakt — a i vi možete da šaljete svoje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allt är klart. Andra användare kan nu skicka kontaktförfrågningar till dig — och du kan skicka dina."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พร้อมแล้ว ผู้ใช้คนอื่นส่งคำขอการติดต่อมาหาคุณได้แล้ว — และคุณก็ส่งของคุณได้เช่นกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her şey hazır. Diğer kullanıcılar artık size iletişim isteği gönderebilir — siz de kendi isteklerinizi gönderebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усе готово. Інші користувачі тепер можуть надсилати вам запити на додавання до контактів — і ви можете надсилати свої."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi thứ đã sẵn sàng. Người dùng khác giờ có thể gửi yêu cầu liên hệ cho bạn — và bạn cũng gửi được của mình."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一切就绪。其他用户现在可以向您发送联系人请求——您也可以发送自己的请求。"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一切就緒。其他用戶現在可以向您發送聯繫請求——您也可以發送自己的請求。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一切就绪。其他用户现在可以向您发送联系人请求——您也可以发送自己的请求。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一切就緒。其他用戶現在可以向您發送聯繫請求——您也可以發送自己的請求。"
          }
        }
      }
    },
