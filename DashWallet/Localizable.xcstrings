    "Any keys you added for it are deleted from this device's keychain too." : {
      "comment" : "Tracked masternodes",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحذف أيضًا كل المفاتيح التي أضفتها لها من سلسلة مفاتيح هذا الجهاز."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всички ключове, които сте добавили за него, също се изтриват от keychain на това устройство."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totes les claus que hi has afegit també se suprimeixen del clauer d'aquest dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny klíče, které jste pro něj přidali, se rovněž smažou z keychainu tohoto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle nøgler, du har tilføjet for den, slettes også fra denne enheds keychain."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Schlüssel, die du dafür hinzugefügt hast, werden ebenfalls aus der Keychain dieses Geräts gelöscht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όσα κλειδιά προσθέσατε γι' αυτό διαγράφονται επίσης από το keychain αυτής της συσκευής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Any keys you added for it are deleted from this device's keychain too."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ĉiuj ŝlosiloj, kiujn vi aldonis por ĝi, ankaŭ estas forigataj el la ŝlosilaro de ĉi tiu aparato."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las claves que hayas añadido para él también se eliminan del llavero de este dispositivo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kõik võtmed, mille sa selle jaoks lisasid, kustutatakse ka selle seadme võtmehoidjast."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر کلیدی که برای آن اضافه کرده‌اید نیز از کی‌چین این دستگاه حذف می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki sille lisäämäsi avaimet poistetaan myös tämän laitteen avainnipusta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buburahin din sa keychain ng device na ito ang anumang key na idinagdag mo para rito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les clés que vous avez ajoutées pour lui sont également supprimées du trousseau de cet appareil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svi ključevi koje ste dodali za njega također se brišu iz keychaina ovog uređaja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az összes hozzá felvett kulcs is törlődik ennek az eszköznek a kulcstartójából."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua kunci yang Anda tambahkan untuknya juga dihapus dari keychain perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche tutte le chiavi che hai aggiunto per esso vengono eliminate dal portachiavi di questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのために追加したキーも、この端末のキーチェーンから削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이를 위해 추가한 키도 이 기기의 키체인에서 삭제됩니다."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сите клучеви што сте ги додале за него исто така се бришат од keychain на овој уред."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebarang kunci yang anda tambah untuknya turut dipadam daripada keychain peranti ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle nøkler du har lagt til for den, slettes også fra denne enhetens nøkkelring."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle sleutels die je ervoor hebt toegevoegd, worden ook uit de sleutelhanger van dit apparaat verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie dodane dla niego klucze są też usuwane z pęku kluczy tego urządzenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as chaves que você adicionou para ele também são excluídas do chaveiro deste dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toate cheile pe care le-ai adăugat pentru el se șterg și din keychain-ul acestui dispozitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все добавленные для неё ключи также удаляются из связки ключей этого устройства."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všetky kľúče, ktoré ste preň pridali, sa tiež vymažú z keychainu tohto zariadenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsi ključi, ki ste jih dodali zanj, se izbrišejo tudi iz keychaina te naprave."
          }
        },
        "sl_SI" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsi ključi, ki ste jih dodali zanj, se izbrišejo tudi iz keychaina te naprave."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Të gjithë çelësat që shtove për të fshihen gjithashtu nga keychain i kësaj pajisjeje."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svi ključevi koje ste dodali za njega takođe se brišu iz keychain-a ovog uređaja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla nycklar du har lagt till för den raderas också från den här enhetens nyckelring."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คีย์ทุกตัวที่คุณเพิ่มให้โหนดนี้จะถูกลบจากคีย์เชนของอุปกรณ์นี้ด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunun için eklediğiniz tüm anahtarlar bu cihazın anahtar zincirinden de silinir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі додані для неї ключі також видаляються зі зв'язки ключів цього пристрою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi khoá bạn đã thêm cho nó cũng bị xoá khỏi keychain của thiết bị này."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你为它添加的所有密钥也会从本设备的钥匙串中删除。"
