    "The temporary username must not itself require voting." : {
      "comment" : "Usernames",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب ألا يتطلب اسم المستخدم المؤقت نفسه تصويتًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Временното потребителско име само по себе си не бива да изисква гласуване."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nom d'usuari temporal no ha de requerir votació ell mateix."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dočasné uživatelské jméno samo nesmí vyžadovat hlasování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det midlertidige brugernavn må ikke selv kræve afstemning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der temporäre Nutzername darf nicht selbst eine Abstimmung erfordern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το προσωρινό όνομα χρήστη δεν πρέπει να απαιτεί το ίδιο ψηφοφορία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The temporary username must not itself require voting."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La provizora uzantnomo mem ne devas postuli voĉdonadon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre de usuario temporal no debe requerir votación él mismo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajutine kasutajanimi ise ei tohi nõuda hääletust."
