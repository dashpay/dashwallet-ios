            "value" : "ยอดคงเหลือ Dash หลักของคุณบนบล็อกเชน Core — ยอดที่คุณส่งและรับกับกระเป๋าเงิน กระดานเทรด และร้านค้าอื่น ๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Core blok zincirindeki ana Dash bakiyeniz — diğer cüzdanlar, borsalar ve satıcılarla gönderip aldığınız tutar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш основний баланс Dash у блокчейні Core — те, що ви надсилаєте й отримуєте з іншими гаманцями, біржами та продавцями."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số dư Dash chính của bạn trên blockchain Core — thứ bạn gửi và nhận với các ví, sàn giao dịch và người bán khác."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您在 Core 区块链上的主要 Dash 余额——用于与其他钱包、交易所和商家收发资金。"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您在 Core 區塊鏈上的主要 Dash 餘額——用於與其他錢包、交易所和商家收付資金。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您在 Core 区块链上的主要 Dash 余额——用于与其他钱包、交易所和商家收发资金。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您在 Core 區塊鏈上的主要 Dash 餘額——用於與其他錢包、交易所和商家收付資金。"
          }
        }
      }
    },
