	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>التصويت على %d اسم مستخدم</string>
			<key>one</key>
			<string>التصويت على %d اسم مستخدم</string>
			<key>two</key>
			<string>التصويت على %d اسم مستخدم</string>
			<key>few</key>
			<string>التصويت على %d اسم مستخدم</string>
			<key>many</key>
			<string>التصويت على %d اسم مستخدم</string>
			<key>other</key>
			<string>التصويت على %d اسم مستخدم</string>
		</dict>
	</dict>
