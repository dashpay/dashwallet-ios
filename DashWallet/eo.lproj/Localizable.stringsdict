			<key>other</key>
			<string>%1$u voĉoj kalkulitaj</string>
		</dict>
	</dict>
	<key>%d of %d usernames voted on</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Voĉdonite pri %1$d el %#@names@</string>
